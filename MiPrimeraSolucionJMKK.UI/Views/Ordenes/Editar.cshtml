@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Ordenes.OrdenDto

@{
    ViewBag.Title = "Editar Orden";
}

<style>
    :root {
        --order-edit-blue-950: #06142f;
        --order-edit-blue-900: #0a1f46;
        --order-edit-blue-800: #10376b;
        --order-edit-blue-700: #185695;
        --order-edit-blue-600: #2878bd;
        --order-edit-blue-500: #4298d4;
        --order-edit-blue-400: #68a5d8;
        --order-edit-blue-300: #9acced;
        --order-edit-blue-200: #c9e5f6;
        --order-edit-blue-100: #e7f3fb;
        --order-edit-blue-50: #f5faff;
        --order-edit-white: #ffffff;
        --order-edit-text: #14263a;
        --order-edit-muted: #718397;
        --order-edit-border: #dce9f3;
        --order-edit-border-light: #eaf1f7;
        --order-edit-shadow-sm: 0 7px 22px rgba(6, 20, 47, .08);
        --order-edit-shadow-md: 0 18px 42px rgba(6, 20, 47, .12);
        --order-edit-shadow-lg: 0 28px 65px rgba(6, 20, 47, .16);
    }

    .edit-order-page {
        width: 100%;
        padding: 18px 0 35px;
    }

    .edit-order-hero {
        position: relative;
        min-height: 230px;
        padding: 42px 46px;
        display: flex;
        align-items: flex-end;
        border-radius: 24px;
        background: radial-gradient(circle at 85% 20%, rgba(104, 165, 216, .25), transparent 30%), radial-gradient(circle at 15% 90%, rgba(40, 120, 189, .18), transparent 32%), linear-gradient(135deg, var(--order-edit-blue-950), var(--order-edit-blue-800));
        box-shadow: var(--order-edit-shadow-lg);
        overflow: hidden;
    }

        .edit-order-hero::before {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -140px;
            top: -160px;
            border: 54px solid rgba(255,255,255,.035);
            border-radius: 50%;
        }

        .edit-order-hero::after {
            content: "EDITAR";
            position: absolute;
            right: 30px;
            bottom: -12px;
            color: rgba(255,255,255,.035);
            font-size: clamp(4rem, 8vw, 8rem);
            font-weight: 800;
            letter-spacing: -.08em;
            line-height: .8;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }

    .edit-order-heading {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }

    .edit-order-eyebrow {
        display: inline-block;
        margin-bottom: 15px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--order-edit-blue-400);
        color: var(--order-edit-blue-100);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .edit-order-heading h1 {
        margin: 0 0 13px;
        color: var(--order-edit-white) !important;
        font-size: clamp(2.3rem, 4vw, 4.1rem);
        font-weight: 800;
        line-height: 1.03;
        letter-spacing: -.055em;
    }

    .edit-order-heading p {
        margin: 0;
        color: rgba(255,255,255,.74);
        font-size: 1rem;
        line-height: 1.7;
    }

    .edit-order-shell {
        margin-top: 25px;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
        gap: 24px;
    }

    .edit-order-panel {
        padding: 32px;
        border: 1px solid var(--order-edit-border);
        border-radius: 20px;
        background: linear-gradient(180deg, var(--order-edit-white), var(--order-edit-blue-50));
        box-shadow: var(--order-edit-shadow-md);
    }

    .edit-order-panel-header {
        margin-bottom: 28px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--order-edit-border-light);
    }

        .edit-order-panel-header h2 {
            margin: 0 0 7px;
            color: var(--order-edit-blue-950);
            font-size: 1.4rem;
            font-weight: 800;
        }

        .edit-order-panel-header p {
            margin: 0;
            color: var(--order-edit-muted);
            font-size: .86rem;
            line-height: 1.6;
        }

    .edit-order-field {
        margin-bottom: 20px;
    }

        .edit-order-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--order-edit-text);
            font-size: .82rem;
            font-weight: 700;
        }

        .edit-order-field .form-control {
            min-height: 140px;
            padding: 14px 15px;
            color: var(--order-edit-text);
            background: var(--order-edit-white);
            border: 1px solid var(--order-edit-border);
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(6,20,47,.04);
            resize: vertical;
        }

            .edit-order-field .form-control:hover {
                border-color: var(--order-edit-blue-300);
            }

            .edit-order-field .form-control:focus {
                border-color: var(--order-edit-blue-500);
                box-shadow: 0 0 0 4px rgba(66,152,212,.12);
            }

    .edit-order-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .edit-order-submit,
    .edit-order-cancel {
        min-height: 52px;
        padding: 13px 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px !important;
        font-size: .88rem;
        font-weight: 800;
        text-decoration: none !important;
    }

    .edit-order-submit {
        border: 1px solid var(--order-edit-blue-600) !important;
        color: var(--order-edit-white) !important;
        background: linear-gradient(135deg, var(--order-edit-blue-600), var(--order-edit-blue-700)) !important;
        box-shadow: 0 9px 22px rgba(40,120,189,.22);
    }

        .edit-order-submit:hover {
            color: var(--order-edit-white) !important;
            background: linear-gradient(135deg, var(--order-edit-blue-700), var(--order-edit-blue-800)) !important;
            transform: translateY(-2px);
        }

    .edit-order-cancel {
        border: 1px solid var(--order-edit-blue-200) !important;
        color: var(--order-edit-blue-700) !important;
        background: var(--order-edit-white) !important;
    }

        .edit-order-cancel:hover {
            color: var(--order-edit-white) !important;
            background: var(--order-edit-blue-700) !important;
            border-color: var(--order-edit-blue-700) !important;
            transform: translateY(-2px);
        }

    .edit-order-aside {
        padding: 30px;
        border: 1px solid var(--order-edit-border);
        border-radius: 20px;
        background: radial-gradient(circle at top right, rgba(104,165,216,.13), transparent 35%), var(--order-edit-white);
        box-shadow: var(--order-edit-shadow-sm);
    }

    .edit-order-aside-number {
        margin-bottom: 20px;
        color: var(--order-edit-blue-100);
        font-size: 5.2rem;
        font-weight: 800;
        letter-spacing: -.08em;
        line-height: .85;
    }

    .edit-order-aside h3 {
        margin-bottom: 12px;
        color: var(--order-edit-blue-950);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .edit-order-aside p {
        margin-bottom: 0;
        color: var(--order-edit-muted);
        font-size: .88rem;
        line-height: 1.7;
    }

    @@media (max-width: 991.98px) {
        .edit-order-shell {
            grid-template-columns: 1fr;
        }

        .edit-order-aside {
            order: -1;
        }
    }

    @@media (max-width: 575.98px) {
        .edit-order-hero {
            min-height: 290px;
            padding: 30px 22px;
            border-radius: 18px;
        }

        .edit-order-heading h1 {
            font-size: 2.4rem;
        }

        .edit-order-panel,
        .edit-order-aside {
            padding: 24px 20px;
            border-radius: 16px;
        }

        .edit-order-actions {
            flex-direction: column;
        }

        .edit-order-submit,
        .edit-order-cancel {
            width: 100%;
        }
    }
</style>

<div class="edit-order-page">

    <section class="edit-order-hero">

        <div class="edit-order-heading">
            <span class="edit-order-eyebrow">
                Gestión de compras
            </span>

            <h1>
                Editar orden
            </h1>

            <p>
                Actualiza las observaciones asociadas a la orden seleccionada.
            </p>
        </div>

    </section>

    <div class="edit-order-shell">

        <section class="edit-order-panel">

            <div class="edit-order-panel-header">
                <h2>Detalles de la orden</h2>
                <p>Modifica las observaciones y guarda los cambios.</p>
            </div>

            @using (Html.BeginForm("Editar", "Ordenes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.NumeroOrden)

                <div class="edit-order-field">
                    <label class="form-label">Observaciones</label>

                    @Html.TextAreaFor(
                        m => m.Observaciones,
                        5,
                        80,
                        new { @class = "form-control" })
                </div>

                <div class="edit-order-actions">

                    <button type="submit"
                            class="btn btn-primary edit-order-submit">
                        Guardar
                    </button>

                    @Html.ActionLink(
                        "Cancelar",
                        "Index",
                        "OrdenesListado",
                        null,
                        new { @class = "btn btn-secondary ms-2 edit-order-cancel" })

                </div>
            }

        </section>

        <aside class="edit-order-aside">

            <div class="edit-order-aside-number">
                02
            </div>

            <h3>
                Mantén la orden documentada
            </h3>

            <p>
                Usa las observaciones para registrar cambios, aclaraciones o detalles importantes de la compra.
            </p>

        </aside>

    </div>

</div>