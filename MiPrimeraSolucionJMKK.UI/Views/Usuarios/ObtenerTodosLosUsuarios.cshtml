@model IEnumerable<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Marketing.MarketingDto>

@{
    ViewBag.Title = "Publicaciones";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-megaphone-fill me-2"></i>Publicaciones</h2>

        @Html.ActionLink("Agregar Publicación", "AgregarPublicacion", null, new { @class = "btn btn-pubrock" })
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0" style="color: var(--terciario);">

                    <thead style="background-color: rgba(234,153,153,0.15); color: var(--acento);">
                        <tr>
                            <th>ID</th>
                            <th>Título</th>
                            <th>Contenido</th>
                            <th>Fecha Publicación</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-color: rgba(245,224,195,0.1);">
                                <td>@item.IdPublicacion</td>

                                <td>
                                    <strong>@item.Titulo</strong>
                                </td>

                                <td>
                                    @(item.Contenido.Length > 50
                                        ? item.Contenido.Substring(0, 50) + "..."
                                        : item.Contenido)
                                </td>

                                <td>@item.FechaPublicacion.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @if (item.IdEstado == 1)
                                    {
                                        <span class="badge" style="background-color: var(--exito); color: #121212;">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background-color: var(--acento); color: #121212;">
                                            Inactiva
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">

                                        @Html.ActionLink(
                                            "Editar",
                                            "EditarPublicacion",
                                            "Publicaciones",
                                            new { idPublicacion = item.IdPublicacion },
                                            new { @class = "btn btn-sm btn-pubrock" }
                                        )

                                        @Html.ActionLink(
                                            "Detalles",
                                            "DetallesDeLaPublicacion",
                                            "Publicaciones",
                                            new { idPublicacion = item.IdPublicacion },
                                            new { @class = "btn btn-sm btn-outline-secondary" }
                                        )

                                        @if (item.IdEstado == 1)
                                        {
                                            using (Html.BeginForm(
                                                "InactivarPublicacion",
                                                "Publicaciones",
                                                new { idPublicacion = item.IdPublicacion },
                                                FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm"
                                                        style="background-color: transparent; border: 1px solid var(--acento); color: var(--acento);"
                                                        onclick="return confirm('¿Desea inactivar esta publicación?')">
                                                    <i class="bi bi-x-circle"></i> Inactivar
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="btn btn-sm disabled"
                                                  style="border: 1px solid rgba(245,224,195,0.2); color: rgba(245,224,195,0.3);">
                                                <i class="bi bi-x-circle"></i> Inactiva
                                            </span>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>