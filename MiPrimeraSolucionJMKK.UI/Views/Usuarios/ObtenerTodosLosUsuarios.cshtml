@model IEnumerable<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Usuarios.UsuarioDto>

@{
    ViewBag.Title = "Usuarios";
}

<div class="container py-3">
    @Html.AntiForgeryToken()
    <div class="card-modern">
        <h2>Usuarios</h2>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

<p>
    @Html.ActionLink("Agregar Usuario", "AgregarUsuario", "Usuarios", null, new { @class = "btn btn-primary" })
</p>

<table class="table-modern">
    <thead>
        <tr>
            <th>Cedula</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Correo</th>
            <th>Telefono</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var u in Model)
            {
                <tr>
                    <td>@u.Cedula</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="avatar me-2">@u.Nombre.Substring(0,1).ToUpper()</div>
                            <div>
                                <div class="fw-bold">@u.Nombre</div>
                                <div class="text-muted" style="font-size:.85rem">@u.CorreoElectronico</div>
                            </div>
                        </div>
                    </td>
                    <td>@u.ApellidoPaterno @u.ApellidoMaterno</td>
                    <td>@u.CorreoElectronico</td>
                    <td>@u.Telefono</td>
                    <td>@u.DescripcionTipoUsuario</td>
                    <td>
                        @if(u.IdEstado == 1){ <span class="badge-status badge-active">Activo</span> } else { <span class="badge-status badge-inactive">Inactivo</span> }
                    </td>
                    <td>
                        <div class="d-flex">
                            <div class="btn-group actions-group" role="group">
                                @Html.ActionLink("Detalles", "DetallesDelUsuario", new { cedula = u.Cedula }, new { @class = "btn btn-sm btn-outline-info" })
                                @Html.ActionLink("Editar", "EditarUsuario", new { cedula = u.Cedula }, new { @class = "btn btn-sm btn-outline-warning" })
                                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    Acciones
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button class="dropdown-item btn-inactivar-user text-danger" data-cedula="@u.Cedula">Inactivar usuario</button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DetallesDelUsuario","Usuarios", new { cedula = u.Cedula })">Ver perfil</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="8" class="text-center">No hay usuarios registrados</td></tr>
        }
    </tbody>

</table>
    </div>
</div>

<script>
    $(function(){
        $('.btn-inactivar-user').click(function(){
            var cedula = $(this).data('cedula');
            Swal.fire({
                title: 'Confirmar inactivación',
                text: '¿Desea inactivar este usuario? Esta acción puede revertirse desde el perfil.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, inactivar',
                cancelButtonText: 'Cancelar'
            }).then(function(result){
                if(!result.isConfirmed) return;

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.post('@Url.Action("InactivarUsuario","Usuarios")', { cedula: cedula, __RequestVerificationToken: token })
                    .done(function(res){
                        // si el controlador devuelve JSON con success
                        try{
                            if(res && res.success){
                                Swal.fire('Inactivado', res.message || 'Usuario inactivado correctamente', 'success').then(function(){ location.reload(); });
                                return;
                            }
                        }catch(e){}
                        // por defecto recargar
                        location.reload();
                    })
                    .fail(function(){
                        Swal.fire('Error', 'No se pudo completar la petición. Intente nuevamente.', 'error');
                    });
            });
        });
    });
</script>
