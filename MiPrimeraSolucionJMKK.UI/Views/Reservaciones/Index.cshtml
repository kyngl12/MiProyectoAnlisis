@model List<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Reservacion.ReservacionDto>

@{
    ViewBag.Title = "Reservaciones";
}

<div class="container py-3">
    <div class="card-modern">
        <h2>Reservaciones</h2>
        <div class="mb-3">
            @Html.ActionLink("Agregar Reservacion", "Registrar", "Reservaciones", null, new { @class = "btn btn-pubrock" })
        </div>

@if (TempData["MensajeInfo"] != null)
{
    <div class="alert alert-info">@TempData["MensajeInfo"]</div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

@Html.AntiForgeryToken()

<table class="table-modern">
    <thead>
        <tr>
            <th>Id</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Cliente</th>
            <th>Observaciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(r.Estado ? "Activa" : "Inactiva")</td>
                <td>@r.Cliente</td>
                <td>@r.Observaciones</td>
                <td>
                    @if (r.Estado)
                    {
                        <div class="d-flex">
                            <button class="btn btn-sm btn-outline-danger btn-cancelar me-2" data-id="@r.Id"><span class="text">Cancelar</span></button>
                            <a href="@Url.Action("Registrar","Reservaciones")" class="btn btn-sm btn-outline-secondary">Ver</a>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>

</table>

    </div>
</div>

@section Scripts {
    <script>
        $(function(){
            $('.btn-cancelar').click(function(){
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Confirmar',
                    text: 'Desea cancelar la reservacion?',
                    icon: 'warning',
                    showCancelButton: true
                }).then(function(resp){
                    if(resp.isConfirmed){
                        $.post('@Url.Action("Cancelar","Reservaciones")', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() }, function(res){
                            if(res.success) { Swal.fire('Ok', res.message, 'success').then(function(){ location.reload(); }); }
                            else Swal.fire('Error', res.message, 'error');
                        }).fail(function(){ Swal.fire('Error','Error servidor','error'); });
                    }
                });
            });
        });
    </script>
}
