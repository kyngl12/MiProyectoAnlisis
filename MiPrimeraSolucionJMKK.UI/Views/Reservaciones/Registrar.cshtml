@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Reservacion.ReservacionRequestDto

@{
    ViewBag.Title = "Registrar Reservacion";
}

<style>
    :root {
        --reserve-blue-950: #06142f;
        --reserve-blue-900: #0a1f46;
        --reserve-blue-800: #10376b;
        --reserve-blue-700: #185695;
        --reserve-blue-600: #2878bd;
        --reserve-blue-500: #4298d4;
        --reserve-blue-400: #68a5d8;
        --reserve-blue-300: #9acced;
        --reserve-blue-200: #c9e5f6;
        --reserve-blue-100: #e7f3fb;
        --reserve-blue-50: #f5faff;
        --reserve-white: #ffffff;
        --reserve-text: #14263a;
        --reserve-muted: #718397;
        --reserve-border: #dce9f3;
        --reserve-border-light: #eaf1f7;
        --reserve-shadow-sm: 0 7px 22px rgba(6, 20, 47, .08);
        --reserve-shadow-md: 0 18px 42px rgba(6, 20, 47, .12);
        --reserve-shadow-lg: 0 28px 65px rgba(6, 20, 47, .16);
    }

    .reserve-form-page {
        width: 100%;
        padding: 18px 0 35px;
    }

    .reserve-form-hero {
        position: relative;
        min-height: 230px;
        padding: 42px 46px;
        display: flex;
        align-items: flex-end;
        border-radius: 24px;
        background: radial-gradient(circle at 85% 20%, rgba(104, 165, 216, .25), transparent 30%), radial-gradient(circle at 15% 90%, rgba(40, 120, 189, .18), transparent 32%), linear-gradient(135deg, var(--reserve-blue-950), var(--reserve-blue-800));
        box-shadow: var(--reserve-shadow-lg);
        overflow: hidden;
    }

        .reserve-form-hero::before {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -140px;
            top: -160px;
            border: 54px solid rgba(255,255,255,.035);
            border-radius: 50%;
        }

        .reserve-form-hero::after {
            content: "RESERVAR";
            position: absolute;
            right: 30px;
            bottom: -12px;
            color: rgba(255,255,255,.035);
            font-size: clamp(4rem, 8vw, 8rem);
            font-weight: 800;
            letter-spacing: -.08em;
            line-height: .8;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }

    .reserve-form-heading {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }

    .reserve-form-eyebrow {
        display: inline-block;
        margin-bottom: 15px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--reserve-blue-400);
        color: var(--reserve-blue-100);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .reserve-form-heading h1 {
        margin: 0 0 13px;
        color: var(--reserve-white) !important;
        font-size: clamp(2.3rem, 4vw, 4.1rem);
        font-weight: 800;
        line-height: 1.03;
        letter-spacing: -.055em;
    }

    .reserve-form-heading p {
        margin: 0;
        color: rgba(255,255,255,.74);
        font-size: 1rem;
        line-height: 1.7;
    }

    .reserve-form-shell {
        margin-top: 25px;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
        gap: 24px;
    }

    .reserve-form-panel {
        padding: 32px;
        border: 1px solid var(--reserve-border);
        border-radius: 20px;
        background: linear-gradient(180deg, var(--reserve-white), var(--reserve-blue-50));
        box-shadow: var(--reserve-shadow-md);
    }

    .reserve-form-panel-header {
        margin-bottom: 28px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--reserve-border-light);
    }

        .reserve-form-panel-header h2 {
            margin: 0 0 7px;
            color: var(--reserve-blue-950);
            font-size: 1.4rem;
            font-weight: 800;
        }

        .reserve-form-panel-header p {
            margin: 0;
            color: var(--reserve-muted);
            font-size: .86rem;
            line-height: 1.6;
        }

    .reserve-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .reserve-field {
        margin-bottom: 18px;
    }

        .reserve-field.full-width {
            grid-column: 1 / -1;
        }

        .reserve-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--reserve-text);
            font-size: .82rem;
            font-weight: 700;
        }

        .reserve-field .form-control {
            min-height: 50px;
            padding: 12px 15px;
            color: var(--reserve-text);
            background: var(--reserve-white);
            border: 1px solid var(--reserve-border);
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(6,20,47,.04);
        }

        .reserve-field textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .reserve-field .form-control:hover {
            border-color: var(--reserve-blue-300);
        }

        .reserve-field .form-control:focus {
            border-color: var(--reserve-blue-500);
            box-shadow: 0 0 0 4px rgba(66,152,212,.12);
        }

    .reserve-form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .reserve-submit,
    .reserve-back {
        min-height: 52px;
        padding: 13px 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px !important;
        font-size: .88rem;
        font-weight: 800;
        text-decoration: none !important;
    }

    .reserve-submit {
        border: 1px solid var(--reserve-blue-600) !important;
        color: var(--reserve-white) !important;
        background: linear-gradient(135deg, var(--reserve-blue-600), var(--reserve-blue-700)) !important;
        box-shadow: 0 9px 22px rgba(40,120,189,.22);
    }

        .reserve-submit:hover {
            color: var(--reserve-white) !important;
            background: linear-gradient(135deg, var(--reserve-blue-700), var(--reserve-blue-800)) !important;
            transform: translateY(-2px);
        }

    .reserve-back {
        border: 1px solid var(--reserve-blue-200) !important;
        color: var(--reserve-blue-700) !important;
        background: var(--reserve-white) !important;
    }

        .reserve-back:hover {
            color: var(--reserve-white) !important;
            background: var(--reserve-blue-700) !important;
            border-color: var(--reserve-blue-700) !important;
            transform: translateY(-2px);
        }

    .reserve-form-aside {
        padding: 30px;
        border: 1px solid var(--reserve-border);
        border-radius: 20px;
        background: radial-gradient(circle at top right, rgba(104,165,216,.13), transparent 35%), var(--reserve-white);
        box-shadow: var(--reserve-shadow-sm);
    }

    .reserve-form-aside-number {
        margin-bottom: 20px;
        color: var(--reserve-blue-100);
        font-size: 5.2rem;
        font-weight: 800;
        letter-spacing: -.08em;
        line-height: .85;
    }

    .reserve-form-aside h3 {
        margin-bottom: 12px;
        color: var(--reserve-blue-950);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .reserve-form-aside p {
        margin-bottom: 0;
        color: var(--reserve-muted);
        font-size: .88rem;
        line-height: 1.7;
    }

    @@media (max-width: 991.98px) {
        .reserve-form-shell {
            grid-template-columns: 1fr;
        }

        .reserve-form-aside {
            order: -1;
        }
    }

    @@media (max-width: 767.98px) {
        .reserve-grid {
            grid-template-columns: 1fr;
        }

        .reserve-field.full-width {
            grid-column: auto;
        }
    }

    @@media (max-width: 575.98px) {
        .reserve-form-hero {
            min-height: 290px;
            padding: 30px 22px;
            border-radius: 18px;
        }

        .reserve-form-heading h1 {
            font-size: 2.4rem;
        }

        .reserve-form-panel,
        .reserve-form-aside {
            padding: 24px 20px;
            border-radius: 16px;
        }

        .reserve-form-actions {
            flex-direction: column;
        }

        .reserve-submit,
        .reserve-back {
            width: 100%;
        }
    }
</style>

<div class="reserve-form-page">

    <section class="reserve-form-hero">

        <div class="reserve-form-heading">
            <span class="reserve-form-eyebrow">
                Gestión de reservaciones
            </span>

            <h1>
                Registrar reservación
            </h1>

            <p>
                Completa la fecha, horario, cliente, mesa y cantidad de personas.
            </p>
        </div>

    </section>

    <div class="reserve-form-shell">

        <section class="reserve-form-panel">

            <div class="reserve-form-panel-header">
                <h2>Información de la reservación</h2>
                <p>Complete todos los datos requeridos antes de registrar.</p>
            </div>

            @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "formReservacion" }))
            {
                @Html.AntiForgeryToken()

                <div class="reserve-grid">

                    <div class="reserve-field">
                        <label>Fecha</label>
                        <input type="date"
                               name="Fecha"
                               class="form-control"
                               required />
                    </div>

                    <div class="reserve-field">
                        <label>Hora inicio</label>
                        <input type="time"
                               name="HoraInicio"
                               class="form-control"
                               required />
                    </div>

                    <div class="reserve-field">
                        <label>Hora fin</label>
                        <input type="time"
                               name="HoraFin"
                               class="form-control"
                               required />
                    </div>

                    <div class="reserve-field">
                        <label>Cantidad de personas</label>
                        <input type="number"
                               name="CantidadPersonas"
                               class="form-control"
                               min="1"
                               required />
                    </div>

                    <div class="reserve-field">
                        <label>Id Cliente</label>
                        <input type="number"
                               name="IdCliente"
                               class="form-control"
                               required />
                    </div>

                    <div class="reserve-field">
                        <label>Id Mesa</label>
                        <input type="number"
                               name="IdMesa"
                               class="form-control"
                               required />
                    </div>

                    <div class="reserve-field full-width">
                        <label>Observaciones</label>
                        <textarea name="Observaciones"
                                  class="form-control"></textarea>
                    </div>

                </div>

                <div class="reserve-form-actions">

                    <button id="btnRegistrarReservacion"
                            type="button"
                            class="btn btn-primary reserve-submit">
                        Registrar
                    </button>

                    @Html.ActionLink(
                        "Volver",
                        "Index",
                        "Reservaciones",
                        null,
                        new { @class = "btn btn-secondary ms-2 reserve-back" })

                </div>
            }

        </section>

        <aside class="reserve-form-aside">

            <div class="reserve-form-aside-number">
                01
            </div>

            <h3>
                Reserva clara y ordenada
            </h3>

            <p>
                Revisa cuidadosamente la fecha, horas, cliente y mesa
                antes de registrar la reservación.
            </p>

        </aside>

    </div>

</div>

@section Scripts {
    <script>
        $(function(){
            $('#btnRegistrarReservacion').click(function(){
                var data = {
                    Fecha: $('input[name=Fecha]').val(),
                    HoraInicio: $('input[name=HoraInicio]').val(),
                    HoraFin: $('input[name=HoraFin]').val(),
                    CantidadPersonas: $('input[name=CantidadPersonas]').val(),
                    IdCliente: $('input[name=IdCliente]').val(),
                    IdMesa: $('input[name=IdMesa]').val(),
                    Observaciones: $('textarea[name=Observaciones]').val()
                };

                // incluir token antiforgery
                data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("Registrar","Reservaciones")',
                    method: 'POST',
                    data: data,
                    success: function(res){
                        if(res.success) {
                            Swal.fire('Exito', res.message, 'success').then(()=> location.href='@Url.Action("Index","Reservaciones")');
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function(){ Swal.fire('Error','Error en el servidor','error'); }
                });
            });
        });
    </script>
}