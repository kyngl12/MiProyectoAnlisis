@model MiPrimeraSolucion.UI.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "¿Olvidó su contraseña?";
}

<style>
    :root {
        --forgot-blue-950: #06142f;
        --forgot-blue-900: #0a1f46;
        --forgot-blue-800: #10376b;
        --forgot-blue-700: #185695;
        --forgot-blue-600: #2878bd;
        --forgot-blue-500: #4298d4;
        --forgot-blue-400: #68a5d8;
        --forgot-blue-300: #9acced;
        --forgot-blue-200: #c9e5f6;
        --forgot-blue-100: #e7f3fb;
        --forgot-blue-50: #f5faff;
        --forgot-white: #ffffff;
        --forgot-text: #14263a;
        --forgot-muted: #718397;
        --forgot-border: #dce9f3;
        --forgot-shadow: 0 28px 70px rgba(6, 20, 47, .20);
    }

    .forgot-page {
        position: relative;
        min-height: calc(100vh - 82px);
        padding: 70px 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 15% 20%, rgba(104, 165, 216, .22), transparent 30%), radial-gradient(circle at 85% 80%, rgba(40, 120, 189, .20), transparent 32%), linear-gradient(135deg, var(--forgot-blue-950) 0%, var(--forgot-blue-900) 45%, var(--forgot-blue-800) 100%);
        overflow: hidden;
    }

        .forgot-page::before {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            right: -220px;
            top: -180px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(104, 165, 216, .11), rgba(104, 165, 216, .025) 58%, transparent 70%);
            filter: blur(4px);
        }

        .forgot-page::after {
            content: "";
            position: absolute;
            width: 440px;
            height: 440px;
            left: -190px;
            bottom: -190px;
            border: 58px solid rgba(255, 255, 255, .035);
            border-radius: 50%;
        }

    .forgot-shell {
        position: relative;
        z-index: 2;
        width: min(1000px, 100%);
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--forgot-white);
        border: 1px solid rgba(255, 255, 255, .20);
        border-radius: 26px;
        box-shadow: var(--forgot-shadow);
        overflow: hidden;
    }

    .forgot-visual {
        position: relative;
        min-height: 560px;
        padding: 55px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: var(--forgot-white);
        background: radial-gradient(circle at 78% 18%, rgba(104, 165, 216, .28), transparent 27%), radial-gradient(circle at 22% 85%, rgba(66, 152, 212, .18), transparent 34%), linear-gradient(145deg, #07172f 0%, #0a244a 50%, #123e72 100%);
        overflow: hidden;
    }

        .forgot-visual::before {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            top: -150px;
            right: -130px;
            border: 55px solid rgba(255, 255, 255, .045);
            border-radius: 50%;
        }

        .forgot-visual::after {
            content: "PUBROCK";
            position: absolute;
            left: 38px;
            bottom: 76px;
            color: rgba(255, 255, 255, .035);
            font-size: clamp(5rem, 9vw, 8.5rem);
            font-weight: 800;
            letter-spacing: -.08em;
            line-height: .8;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }

    .forgot-decor-line {
        position: absolute;
        left: 55px;
        right: 55px;
        top: 50%;
        height: 1px;
        background: linear-gradient(90deg, rgba(255,255,255,.02), rgba(104,165,216,.34), rgba(255,255,255,.02));
        transform: rotate(-14deg);
    }

    .forgot-decor-dot {
        position: absolute;
        width: 12px;
        height: 12px;
        border: 2px solid rgba(154, 204, 237, .50);
        border-radius: 50%;
    }

        .forgot-decor-dot.dot-one {
            top: 28%;
            left: 18%;
        }

        .forgot-decor-dot.dot-two {
            top: 42%;
            right: 17%;
            width: 18px;
            height: 18px;
        }

        .forgot-decor-dot.dot-three {
            bottom: 20%;
            left: 28%;
            width: 8px;
            height: 8px;
        }

    .forgot-brand,
    .forgot-visual-content {
        position: relative;
        z-index: 2;
    }

    .forgot-brand {
        display: inline-block;
        align-self: flex-start;
        padding-bottom: 9px;
        color: var(--forgot-white);
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -.045em;
    }

        .forgot-brand::after {
            content: "";
            display: block;
            width: 100%;
            height: 3px;
            margin-top: 7px;
            border-radius: 999px;
            background: var(--forgot-blue-400);
        }

    .forgot-eyebrow {
        display: inline-block;
        margin-bottom: 18px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--forgot-blue-400);
        color: var(--forgot-blue-100);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .forgot-visual h1 {
        margin-bottom: 20px;
        color: var(--forgot-white) !important;
        font-size: clamp(2.3rem, 4vw, 3.8rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -.055em;
    }

    .forgot-visual p {
        margin-bottom: 0;
        color: rgba(255, 255, 255, .76);
        font-size: 1rem;
        line-height: 1.75;
    }

    .forgot-form-panel {
        padding: 58px 52px;
        display: flex;
        align-items: center;
        background: linear-gradient(180deg, var(--forgot-white), var(--forgot-blue-50));
    }

    .forgot-form-inner {
        width: 100%;
        max-width: 430px;
        margin: auto;
    }

    .forgot-form-header {
        margin-bottom: 30px;
    }

        .forgot-form-header .section-label {
            display: inline-block;
            margin-bottom: 12px;
            padding-bottom: 7px;
            border-bottom: 2px solid var(--forgot-blue-500);
            color: var(--forgot-blue-700);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .15em;
            text-transform: uppercase;
        }

        .forgot-form-header h2 {
            margin-bottom: 12px;
            color: var(--forgot-blue-950) !important;
            font-size: 2.1rem;
            font-weight: 800;
            letter-spacing: -.045em;
        }

        .forgot-form-header p {
            margin-bottom: 0;
            color: var(--forgot-muted);
            line-height: 1.7;
        }

    .forgot-form-panel .form-label {
        margin-bottom: 8px;
        color: var(--forgot-text);
        font-size: .82rem;
        font-weight: 700;
    }

    .forgot-form-panel .form-control {
        min-height: 50px;
        padding: 12px 15px;
        color: var(--forgot-text);
        background: var(--forgot-white);
        border: 1px solid var(--forgot-border);
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(6, 20, 47, .04);
    }

        .forgot-form-panel .form-control::placeholder {
            color: #9aabba;
        }

        .forgot-form-panel .form-control:hover {
            border-color: var(--forgot-blue-300);
        }

        .forgot-form-panel .form-control:focus {
            border-color: var(--forgot-blue-500);
            box-shadow: 0 0 0 4px rgba(66, 152, 212, .12);
        }

    .forgot-submit-row {
        margin-top: 24px;
    }

    .forgot-submit {
        width: 100%;
        min-height: 52px;
        border: 1px solid var(--forgot-blue-600) !important;
        border-radius: 10px !important;
        color: var(--forgot-white) !important;
        background: linear-gradient(135deg, var(--forgot-blue-600), var(--forgot-blue-700)) !important;
        font-size: .9rem;
        font-weight: 800;
        letter-spacing: .02em;
        box-shadow: 0 9px 22px rgba(40, 120, 189, .22);
    }

        .forgot-submit:hover {
            color: var(--forgot-white) !important;
            background: linear-gradient(135deg, var(--forgot-blue-700), var(--forgot-blue-800)) !important;
            box-shadow: 0 13px 28px rgba(40, 120, 189, .28);
            transform: translateY(-2px);
        }

    .forgot-form-panel .validation-summary-errors {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid #f3c5ca;
        border-radius: 10px;
        color: #842029;
        background: #fff2f3;
        font-size: .82rem;
    }

        .forgot-form-panel .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .forgot-form-panel .text-danger {
        display: block;
        margin-top: 6px;
        font-size: .78rem;
    }

    @@media (max-width: 991.98px) {
        .forgot-page {
            min-height: auto;
            padding: 110px 22px 50px;
        }

        .forgot-shell {
            grid-template-columns: 1fr;
            max-width: 650px;
        }

        .forgot-visual {
            min-height: 330px;
            padding: 38px;
        }

        .forgot-form-panel {
            padding: 48px 40px;
        }
    }

    @@media (max-width: 575.98px) {
        .forgot-page {
            padding: 95px 15px 35px;
        }

        .forgot-shell {
            border-radius: 18px;
        }

        .forgot-visual {
            min-height: 290px;
            padding: 30px 24px;
        }

            .forgot-visual h1 {
                font-size: 2.25rem;
            }

        .forgot-form-panel {
            padding: 36px 24px;
        }

        .forgot-form-header h2 {
            font-size: 1.85rem;
        }
    }
</style>

<main class="forgot-page">
    <div class="forgot-shell">

        <section class="forgot-visual">
            <div class="forgot-decor-line"></div>
            <span class="forgot-decor-dot dot-one"></span>
            <span class="forgot-decor-dot dot-two"></span>
            <span class="forgot-decor-dot dot-three"></span>

            <div class="forgot-brand">
                PubRock
            </div>

            <div class="forgot-visual-content">
                <span class="forgot-eyebrow">
                    Recuperación de acceso
                </span>

                <h1>
                    Recupera tu cuenta de forma segura
                </h1>

                <p>
                    Ingresa tu correo electrónico y recibirás el enlace necesario
                    para restablecer tu contraseña.
                </p>
            </div>
        </section>

        <section class="forgot-form-panel">
            <div class="forgot-form-inner">

                <div class="forgot-form-header">
                    <span class="section-label">
                        Restablecer acceso
                    </span>

                    <h2>
                        Recuperar contraseña
                    </h2>

                    <p>
                        Especifique su correo electrónico para recibir el enlace
                        de recuperación.
                    </p>
                </div>

                @using (Html.BeginForm(
                    "ForgotPassword",
                    "Account",
                    FormMethod.Post,
                    new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        "",
                        new { @class = "text-danger small mb-3" })

                    <div class="mb-4">
                        @Html.LabelFor(
                            m => m.Email,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            m => m.Email,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Ej: usuario@pubrock.com"
                            })
                    </div>

                    <div class="forgot-submit-row">
                        <input type="submit"
                               class="btn btn-pubrock forgot-submit"
                               value="Enviar enlace" />
                    </div>
                }

            </div>
        </section>

    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}