@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Productos.ProductoDto

@{
    ViewBag.Title = "Editar Producto";
}

<style>
    :root {
        --edit-blue-950: #06142f;
        --edit-blue-900: #0a1f46;
        --edit-blue-800: #10376b;
        --edit-blue-700: #185695;
        --edit-blue-600: #2878bd;
        --edit-blue-500: #4298d4;
        --edit-blue-400: #68a5d8;
        --edit-blue-300: #9acced;
        --edit-blue-200: #c9e5f6;
        --edit-blue-100: #e7f3fb;
        --edit-blue-50: #f5faff;
        --edit-white: #ffffff;
        --edit-text: #14263a;
        --edit-muted: #718397;
        --edit-border: #dce9f3;
        --edit-border-light: #eaf1f7;
        --edit-shadow-sm: 0 7px 22px rgba(6, 20, 47, .08);
        --edit-shadow-md: 0 18px 42px rgba(6, 20, 47, .12);
        --edit-shadow-lg: 0 28px 65px rgba(6, 20, 47, .16);
    }

    .edit-product-page {
        width: 100%;
        padding: 18px 0 35px;
    }

    .edit-product-hero {
        position: relative;
        min-height: 230px;
        padding: 42px 46px;
        display: flex;
        align-items: flex-end;
        border-radius: 24px;
        background: radial-gradient(circle at 85% 20%, rgba(104, 165, 216, .25), transparent 30%), radial-gradient(circle at 15% 90%, rgba(40, 120, 189, .18), transparent 32%), linear-gradient(135deg, var(--edit-blue-950), var(--edit-blue-800));
        box-shadow: var(--edit-shadow-lg);
        overflow: hidden;
    }

        .edit-product-hero::before {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -140px;
            top: -160px;
            border: 54px solid rgba(255, 255, 255, .035);
            border-radius: 50%;
        }

        .edit-product-hero::after {
            content: "EDITAR";
            position: absolute;
            right: 30px;
            bottom: -12px;
            color: rgba(255, 255, 255, .035);
            font-size: clamp(4rem, 8vw, 8rem);
            font-weight: 800;
            letter-spacing: -.08em;
            line-height: .8;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }

    .edit-product-heading {
        position: relative;
        z-index: 2;
        max-width: 700px;
    }

    .edit-product-eyebrow {
        display: inline-block;
        margin-bottom: 15px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--edit-blue-400);
        color: var(--edit-blue-100);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .edit-product-heading h1 {
        margin: 0 0 13px;
        color: var(--edit-white) !important;
        font-size: clamp(2.3rem, 4vw, 4.1rem);
        font-weight: 800;
        line-height: 1.03;
        letter-spacing: -.055em;
    }

    .edit-product-heading p {
        margin: 0;
        color: rgba(255, 255, 255, .74);
        font-size: 1rem;
        line-height: 1.7;
    }

    .edit-product-alerts {
        margin-top: 24px;
    }

        .edit-product-alerts .alert {
            margin-bottom: 12px;
            padding: 14px 17px;
            border-radius: 12px;
            font-size: .86rem;
            font-weight: 600;
            box-shadow: 0 5px 14px rgba(6, 20, 47, .05);
        }

        .edit-product-alerts .alert-success {
            color: #1f6942;
            background: #effaf4;
            border-color: #bfe7cf;
        }

        .edit-product-alerts .alert-danger {
            color: #842029;
            background: #fff2f3;
            border-color: #f3c5ca;
        }

    .edit-product-shell {
        margin-top: 25px;
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
        gap: 24px;
    }

    .edit-product-panel {
        padding: 32px;
        border: 1px solid var(--edit-border);
        border-radius: 20px;
        background: linear-gradient( 180deg, var(--edit-white), var(--edit-blue-50) );
        box-shadow: var(--edit-shadow-md);
    }

    .edit-product-panel-header {
        margin-bottom: 28px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--edit-border-light);
    }

        .edit-product-panel-header h2 {
            margin: 0 0 7px;
            color: var(--edit-blue-950);
            font-size: 1.4rem;
            font-weight: 800;
        }

        .edit-product-panel-header p {
            margin: 0;
            color: var(--edit-muted);
            font-size: .86rem;
            line-height: 1.6;
        }

    .edit-product-field {
        margin-bottom: 20px;
    }

        .edit-product-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--edit-text);
            font-size: .82rem;
            font-weight: 700;
        }

        .edit-product-field .form-control,
        .edit-product-field select.form-control {
            min-height: 50px;
            padding: 12px 15px;
            color: var(--edit-text);
            background: var(--edit-white);
            border: 1px solid var(--edit-border);
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(6, 20, 47, .04);
            transition: border-color .16s ease, box-shadow .16s ease;
        }

            .edit-product-field .form-control:hover,
            .edit-product-field select.form-control:hover {
                border-color: var(--edit-blue-300);
            }

            .edit-product-field .form-control:focus,
            .edit-product-field select.form-control:focus {
                border-color: var(--edit-blue-500);
                box-shadow: 0 0 0 4px rgba(66, 152, 212, .12);
            }

        .edit-product-field .text-danger {
            display: block;
            margin-top: 6px;
            font-size: .78rem;
        }

    .edit-product-validation {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid #f3c5ca;
        border-radius: 10px;
        color: #842029;
        background: #fff2f3;
        font-size: .82rem;
    }

        .edit-product-validation ul {
            margin: 0;
            padding-left: 18px;
        }

    .edit-product-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .edit-product-submit,
    .edit-product-cancel {
        min-height: 52px;
        padding: 13px 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px !important;
        font-size: .88rem;
        font-weight: 800;
        letter-spacing: .02em;
        text-decoration: none !important;
        transition: transform .16s ease, box-shadow .16s ease;
    }

    .edit-product-submit {
        border: 1px solid var(--edit-blue-600) !important;
        color: var(--edit-white) !important;
        background: linear-gradient( 135deg, var(--edit-blue-600), var(--edit-blue-700) ) !important;
        box-shadow: 0 9px 22px rgba(40, 120, 189, .22);
    }

        .edit-product-submit:hover {
            color: var(--edit-white) !important;
            background: linear-gradient( 135deg, var(--edit-blue-700), var(--edit-blue-800) ) !important;
            box-shadow: 0 13px 28px rgba(40, 120, 189, .28);
            transform: translateY(-2px);
        }

    .edit-product-cancel {
        border: 1px solid var(--edit-blue-200) !important;
        color: var(--edit-blue-700) !important;
        background: var(--edit-white) !important;
    }

        .edit-product-cancel:hover {
            color: var(--edit-white) !important;
            background: var(--edit-blue-700) !important;
            border-color: var(--edit-blue-700) !important;
            transform: translateY(-2px);
        }

    .edit-product-aside {
        padding: 30px;
        border: 1px solid var(--edit-border);
        border-radius: 20px;
        background: radial-gradient(circle at top right, rgba(104, 165, 216, .13), transparent 35%), var(--edit-white);
        box-shadow: var(--edit-shadow-sm);
    }

    .edit-product-aside-number {
        margin-bottom: 20px;
        color: var(--edit-blue-100);
        font-size: 5.2rem;
        font-weight: 800;
        letter-spacing: -.08em;
        line-height: .85;
    }

    .edit-product-aside h3 {
        margin-bottom: 12px;
        color: var(--edit-blue-950);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .edit-product-aside p {
        margin-bottom: 0;
        color: var(--edit-muted);
        font-size: .88rem;
        line-height: 1.7;
    }

    @@media (max-width: 991.98px) {
        .edit-product-shell {
            grid-template-columns: 1fr;
        }

        .edit-product-aside {
            order: -1;
        }
    }

    @@media (max-width: 575.98px) {
        .edit-product-hero {
            min-height: 290px;
            padding: 30px 22px;
            border-radius: 18px;
        }

        .edit-product-heading h1 {
            font-size: 2.4rem;
        }

        .edit-product-panel,
        .edit-product-aside {
            padding: 24px 20px;
            border-radius: 16px;
        }

        .edit-product-actions {
            flex-direction: column;
        }

        .edit-product-submit,
        .edit-product-cancel {
            width: 100%;
        }
    }
</style>

<div class="edit-product-page">

    <section class="edit-product-hero">

        <div class="edit-product-heading">

            <span class="edit-product-eyebrow">
                Gestión de inventario
            </span>

            <h1>
                Editar producto
            </h1>

            <p>
                Actualiza la información del producto, su categoría,
                existencias y precio unitario.
            </p>

        </div>

    </section>

    <div class="edit-product-alerts">

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensajeError"]
            </div>
        }

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }

    </div>

    <div class="edit-product-shell">

        <section class="edit-product-panel">

            <div class="edit-product-panel-header">

                <h2>
                    Información del producto
                </h2>

                <p>
                    Modifica únicamente los campos que necesites actualizar.
                </p>

            </div>

            @using (Html.BeginForm(
                "EditarProducto",
                "Inventario",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "Por favor corrija los errores del formulario",
                    new
                    {
                        @class = "edit-product-validation"
                    })

                @* ID oculto para saber qué producto editar *@
                @Html.HiddenFor(m => m.IdProducto)

                <div class="edit-product-field">

                    @Html.LabelFor(m => m.Codigo)

                    @Html.TextBoxFor(
                        m => m.Codigo,
                        new
                        {
                            @class = "form-control form-control-lg"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Codigo,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="edit-product-field">

                    @Html.LabelFor(m => m.Nombre)

                    @Html.TextBoxFor(
                        m => m.Nombre,
                        new
                        {
                            @class = "form-control form-control-lg"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Nombre,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="edit-product-field">

                    @Html.LabelFor(m => m.Categoria)

                    @Html.DropDownListFor(
                        m => m.Categoria,
                        ViewBag.Categorias as System.Web.Mvc.SelectList,
                        "-- Seleccione --",
                        new
                        {
                            @class = "form-control form-control-lg"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Categoria,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="edit-product-field">

                    @Html.LabelFor(m => m.Cantidad)

                    @Html.TextBoxFor(
                        m => m.Cantidad,
                        new
                        {
                            @class = "form-control form-control-lg",
                            type = "number",
                            step = "1",
                            min = "0"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Cantidad,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="edit-product-field">

                    @Html.LabelFor(m => m.PrecioUnitario)

                    @Html.TextBoxFor(
                        m => m.PrecioUnitario,
                        new
                        {
                            @class = "form-control form-control-lg",
                            type = "number",
                            step = "0.01",
                            min = "0"
                        })

                    @Html.ValidationMessageFor(
                        m => m.PrecioUnitario,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

                <div class="edit-product-actions">

                    <button class="btn btn-primary btn-lg edit-product-submit"
                            type="submit">
                        Guardar cambios
                    </button>

                    @Html.ActionLink(
                        "Cancelar",
                        "ObtenerProductos",
                        null,
                        new
                        {
                            @class = "btn btn-secondary btn-lg edit-product-cancel"
                        })

                </div>
            }

        </section>

        <aside class="edit-product-aside">

            <div class="edit-product-aside-number">
                02
            </div>

            <h3>
                Mantén el inventario actualizado
            </h3>

            <p>
                Revisa cuidadosamente el código, la cantidad y el precio
                antes de guardar los cambios.
            </p>

        </aside>

    </div>

</div>