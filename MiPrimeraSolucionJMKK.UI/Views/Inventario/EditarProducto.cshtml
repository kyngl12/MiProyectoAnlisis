@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Productos.ProductoDto

@{
    ViewBag.Title = "Editar Producto";
}

<h2>Editar Producto</h2>

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

@using (Html.BeginForm("EditarProducto", "Inventario", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "Por favor corrija los errores del formulario", new { @class = "text-danger" })

    @* ID oculto para saber qué producto editar *@
    @Html.HiddenFor(m => m.IdProducto)

    <div class="mb-3">
        @Html.LabelFor(m => m.Codigo)
        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Categoria)
        @Html.DropDownListFor(
            m => m.Categoria,
            ViewBag.Categorias as System.Web.Mvc.SelectList,
            "-- Seleccione --",
            new { @class = "form-control" }
        )
        @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Cantidad)
        @Html.TextBoxFor(m => m.Cantidad, new { @class = "form-control", type = "number", step = "1", min = "0" })
        @Html.ValidationMessageFor(m => m.Cantidad, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.PrecioUnitario)
        @Html.TextBoxFor(m => m.PrecioUnitario, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
        @Html.ValidationMessageFor(m => m.PrecioUnitario, "", new { @class = "text-danger" })
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Guardar Cambios</button>

        @Html.ActionLink("Cancelar", "ObtenerProductos", null, new { @class = "btn btn-secondary" })
    </div>
}
