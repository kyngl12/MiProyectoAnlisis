@model List<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Productos.ProductoDto>

@{
    ViewBag.Title = "Inventario";
}

<div class="container py-3">
    <div class="card-modern">
        <h2>Inventario de Productos</h2>

@if (TempData["MensajeInfo"] != null)
{
    <div class="alert alert-info">@TempData["MensajeInfo"]</div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}

@if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
{
    <p>
        <a class="btn btn-pubrock btn-rounded" href="@Url.Action("AgregarProducto", "Inventario")">
            Agregar Producto
        </a>
    </p>
}

<form method="post" action="@Url.Action("Buscar", "Inventario")" class="mb-3">
    <div class="input-group rounded-pill overflow-hidden" style="max-width:540px">
        <input type="text" name="termino" class="form-control form-control-sm" placeholder="Buscar por nombre o codigo" />
        <button class="btn btn-outline-secondary btn-sm" type="submit">Buscar</button>
    </div>
</form>

<table class="table-modern">
    <thead>
        <tr>
            <th>Codigo</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>@p.Codigo</td>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria</td>

                    <td>
                        @p.Cantidad

                        @if (p.Cantidad <= 5)
                        {
                            <span class="badge bg-danger ms-2">Stock Bajo</span>
                        }
                    </td>

                    <td>@p.PrecioUnitario</td>

                    <td>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group" role="group">
                                    @Html.ActionLink("Editar", "EditarProducto", new { id = p.IdProducto }, new { @class = "btn btn-sm btn-outline-warning" })
                                    @using (Html.BeginForm("EliminarProducto", "Inventario", FormMethod.Post, new { @class = "m-0 p-0" }))
                                    {
                                        @Html.Hidden("id", p.IdProducto)
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este producto?');">Eliminar</button>
                                    }
                                </div>

                                <div>
                                    @using (Html.BeginForm("RegistrarMovimiento", "Inventario", FormMethod.Post, new { @class = "d-flex gap-1 align-items-center m-0" }))
                                    {
                                        @Html.Hidden("idProducto", p.IdProducto)
                                        <input type="number" name="cantidad" class="form-control form-control-sm" placeholder="Cant" required style="width:80px" />
                                        <select name="tipo" class="form-select form-select-sm" style="width:110px">
                                            <option value="ENTRADA">Entrada</option>
                                            <option value="SALIDA">Salida</option>
                                        </select>
                                        <input type="text" name="motivo" class="form-control form-control-sm" placeholder="Motivo" style="width:140px" />
                                        <button type="submit" class="btn btn-sm btn-pubrock">OK</button>
                                    }
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No hay productos registrados</td>
            </tr>
        }
    </tbody>

</table>
    </div>
</div>
