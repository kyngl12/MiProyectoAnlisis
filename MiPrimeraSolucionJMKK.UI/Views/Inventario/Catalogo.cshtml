@model List<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Productos.ProductoDto>

@{
    ViewBag.Title = "Nuestro Menu - PubRock";
}

<style>
    .menu-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

        .menu-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
        }

    .price-tag {
        font-size: 1.25rem;
        font-weight: 700;
        color: #212529;
    }
</style>

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold text-dark mb-2">Nuestro Menu</h1>
        <p class="text-muted fs-5">
            Sabor artesanal, ingredientes frescos y la mejor combinacion para mejorar al mil tu experiencia.
        </p>
    </div>

    @if (TempData["MensajeInfo"] != null)
    {
        <div class="alert alert-info rounded-3 text-center shadow-sm mb-4">
            @TempData["MensajeInfo"]
        </div>
    }

    <!-- FILTRO POR CATEGORIA -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-6 col-lg-5">
            @using (Html.BeginForm("Catalogo", "Inventario", FormMethod.Post, new { @class = "d-flex gap-2 shadow-sm p-2 bg-white rounded-pill border" }))
            {
                @Html.DropDownList(
                    "categoria",
                    ViewBag.Categorias as SelectList,
                    "-- Todas las categorias --",
                    new { @class = "form-select border-0 shadow-none bg-transparent ps-3" })

                <button type="submit" class="btn btn-dark rounded-pill px-4 fw-semibold">
                    Filtrar
                </button>
            }
        </div>
    </div>

    <!-- CUADRICULA DEL MENU -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card menu-card h-100 rounded-4 shadow-sm bg-white p-3 d-flex flex-column justify-content-between">

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-dark border fw-normal px-2 py-1 rounded-pill">
                                    @p.Categoria
                                </span>

                                @if (p.Cantidad <= 0)
                                {
                                    <span class="badge bg-secondary text-white rounded-pill">Agotado</span>
                                }
                            </div>

                            <h4 class="fw-bold text-dark mb-2">@p.Nombre</h4>

                            <p class="text-muted small mb-3">
                                Preparado al instante con la receta especial de la casa.
                            </p>
                        </div>

                        <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-auto">
                            <div>
                                <small class="text-muted d-block lh-1">Precio</small>
                                <span class="price-tag">&#8353; @p.PrecioUnitario.ToString("N0")</span>
                            </div>

                            @if (p.Cantidad > 0)
                            {
                                <span class="text-success fw-semibold small">
                                    Disponible
                                </span>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- MENSAJE SIN PRODUCTOS -->
        <div class="text-center py-5 rounded-4 bg-light border">
            <h4 class="fw-bold text-dark">No hay productos en esta categoria</h4>
            <p class="text-muted mb-0">Intenta seleccionando otra categoria o regresa mas tarde.</p>
        </div>
    }

</div>