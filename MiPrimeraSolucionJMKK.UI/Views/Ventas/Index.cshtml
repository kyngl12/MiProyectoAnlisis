@{
    ViewBag.Title = "Ventas";
}

<h2 class="fw-bold mb-4">Punto de Venta</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Productos disponibles</div>
            <div class="card-body">
                <div class="input-group mb-3">
                    <input type="text" id="txtBuscarProducto" class="form-control" placeholder="Buscar por nombre, codigo o categoria" />
                    <button type="button" id="btnBuscarProducto" class="btn btn-outline-secondary">Buscar</button>
                </div>
                <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Codigo</th>
                                <th>Nombre</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tblProductos"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Venta actual</div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-6">
                        <label>Empleado</label>
                        <select id="idEmpleado" class="form-select"></select>
                    </div>
                    <div class="col-6">
                        <label>Cliente (opcional)</label>
                        <input type="number" id="idCliente" class="form-control" min="1" />
                    </div>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tblDetalleVenta"></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="text-end fw-bold">Total:</td>
                            <td id="totalVenta" class="fw-bold">C0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
                <button type="button" id="btnRegistrarVenta" class="btn btn-primary w-100" disabled>Registrar venta</button>
            </div>
        </div>

        <div class="card mb-4" id="cardOperarVenta" style="display:none;">
            <div class="card-header">Venta #<span id="idVentaActual"></span></div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-7">
                        <label>Tipo de pago</label>
                        <select id="idTipoPago" class="form-select"></select>
                    </div>
                    <div class="col-5 d-flex align-items-end">
                        <button type="button" id="btnProcesarVenta" class="btn btn-success w-100">Cobrar</button>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-7">
                        <label>Motivo de anulacion (opcional)</label>
                        <input type="text" id="motivoAnulacion" class="form-control" />
                    </div>
                    <div class="col-5 d-flex align-items-end">
                        <button type="button" id="btnAnularVenta" class="btn btn-danger w-100">Anular venta</button>
                    </div>
                </div>
                <pre id="detalleVenta" class="bg-light p-2" style="min-height:80px; white-space:pre-wrap;"></pre>
            </div>
        </div>
    </div>
</div>

<!-- ===== OFFCANVAS FACTURA ===== -->
<div class="offcanvas offcanvas-end offcanvas-factura" tabindex="-1" id="offcanvasFactura" aria-labelledby="offcanvasFacturaLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasFacturaLabel">Factura</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <div class="factura-container" id="factura-container">
            <!-- Factura renderizada aquí -->
        </div>
        <div class="factura-actions">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cerrar</button>
            <button type="button" class="btn btn-primary" id="btnDescargarPDF">
                <i class="bi bi-download"></i> Descargar PDF
            </button>
        </div>
    </div>
</div>

<!-- TEMPLATE: Factura (oculto, clonado dinámicamente) -->
@Html.Partial("_FacturaTemplate")

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index: 9999;">
</div>

<!-- Toast Template (hidden, cloned when needed) -->
<div class="toast" id="toastTemplate" role="alert" aria-live="assertive" aria-atomic="true" style="display: none;">
    <div class="toast-header">
        <strong class="me-auto" id="toastTitulo">Aviso</strong>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Cerrar"></button>
    </div>
    <div class="toast-body" id="toastCuerpo">
    </div>
</div>

@section scripts {
    <script>
        var productosDisponibles = [];
        var detalleActual = [];
        var idVentaActiva = null;

        function formatoMoneda(valor) {
            return "C" + Number(valor || 0).toFixed(2);
        }

        function mostrarMensaje(mensaje, titulo) {
            var toastTemplate = document.getElementById("toastTemplate");
            var toastClone = toastTemplate.cloneNode(true);
            toastClone.id = "toast_" + Date.now();
            toastClone.style.display = "block";

            toastClone.querySelector("#toastTitulo").textContent = titulo || "Aviso";
            toastClone.querySelector("#toastCuerpo").textContent = mensaje;

            document.getElementById("toastContainer").appendChild(toastClone);

            var toast = new bootstrap.Toast(toastClone);
            toast.show();

            // Remover el elemento del DOM cuando se cierre
            toastClone.addEventListener("hidden.bs.toast", function () {
                toastClone.remove();
            });
        }

        function mostrarError(resp) {
            var mensaje = (resp && resp.message) ? resp.message : "Error en el sistema, por favor intente nuevamente.";
            mostrarMensaje(mensaje, "Error");
        }

        function renderProductos() {
            var $tbody = $("#tblProductos");
            $tbody.empty();
            if (productosDisponibles.length === 0) {
                $tbody.append("<tr><td colspan='5' class='text-center text-muted'>No hay productos disponibles.</td></tr>");
                return;
            }
            productosDisponibles.forEach(function (p) {
                $tbody.append(
                    "<tr><td>" + (p.Codigo || "") + "</td><td>" + p.Nombre + "</td><td>" + formatoMoneda(p.Precio) + "</td><td>" + p.StockDisponible + "</td>" +
                    "<td><button type='button' class='btn btn-sm btn-outline-primary' data-id='" + p.IdProducto + "'>Agregar</button></td></tr>"
                );
            });
        }

        function renderDetalle() {
            var $tbody = $("#tblDetalleVenta");
            $tbody.empty();
            var total = 0;
            detalleActual.forEach(function (item, idx) {
                var subtotal = item.cantidad * item.precio;
                total += subtotal;
                $tbody.append(
                    "<tr><td>" + item.nombre + "</td>" +
                    "<td><input type='number' min='1' class='form-control form-control-sm cantidad-detalle' data-idx='" + idx + "' value='" + item.cantidad + "' style='width:80px;' /></td>" +
                    "<td>" + formatoMoneda(subtotal) + "</td>" +
                    "<td><button type='button' class='btn btn-sm btn-outline-danger quitar-detalle' data-idx='" + idx + "'>Quitar</button></td></tr>"
                );
            });
            $("#totalVenta").text(formatoMoneda(total));
            $("#btnRegistrarVenta").prop("disabled", detalleActual.length === 0);
        }

        function cargarDatosIniciales() {
            $.get("@Url.Action("ObtenerDatosIniciales", "Ventas")")
                .done(function (resp) {
                    if (!resp.success) {
                        mostrarError(resp);
                        return;
                    }
                    productosDisponibles = resp.productos || [];
                    renderProductos();

                    var $tipoPago = $("#idTipoPago").empty();
                    (resp.tiposPago || []).forEach(function (tp) {
                        $tipoPago.append("<option value='" + tp.IdTipoPago + "'>" + tp.Descripcion + "</option>");
                    });
                })
                .fail(function () { mostrarError(); });

            $.get("@Url.Action("ObtenerEmpleados", "Ventas")")
                .done(function (resp) {
                    if (!resp.success) return;
                    var $empleado = $("#idEmpleado").empty();
                    (resp.data || []).forEach(function (e) {
                        $empleado.append("<option value='" + e.IdEmpleado + "'>" + e.Nombre + "</option>");
                    });
                });
        }

        $("#btnBuscarProducto").on("click", function () {
            $.get("@Url.Action("BuscarProductos", "Ventas")", { texto: $("#txtBuscarProducto").val() })
                .done(function (resp) {
                    if (!resp.success) {
                        mostrarError(resp);
                        return;
                    }
                    productosDisponibles = resp.data || [];
                    renderProductos();
                })
                .fail(function () { mostrarError(); });
        });

        $("#txtBuscarProducto").on("keypress", function (e) {
            // Enter dispara la busqueda sin recargar la pagina.
            if (e.which === 13) { $("#btnBuscarProducto").click(); }
        });

        $("#tblProductos").on("click", "button[data-id]", function () {
            var idProducto = parseInt($(this).data("id"), 10);
            var producto = productosDisponibles.find(function (p) { return p.IdProducto === idProducto; });
            if (!producto) return;

            var existente = detalleActual.find(function (d) { return d.idProducto === idProducto; });
            if (existente) {
                existente.cantidad += 1;
            } else {
                detalleActual.push({ idProducto: producto.IdProducto, nombre: producto.Nombre, precio: producto.Precio, cantidad: 1 });
            }
            renderDetalle();
        });

        $("#tblDetalleVenta").on("change", ".cantidad-detalle", function () {
            var idx = parseInt($(this).data("idx"), 10);
            var cantidad = parseInt($(this).val(), 10);
            if (!cantidad || cantidad <= 0) cantidad = 1;
            detalleActual[idx].cantidad = cantidad;
            renderDetalle();
        });

        $("#tblDetalleVenta").on("click", ".quitar-detalle", function () {
            var idx = parseInt($(this).data("idx"), 10);
            detalleActual.splice(idx, 1);
            renderDetalle();
        });

        $("#btnRegistrarVenta").on("click", function () {
            if (detalleActual.length === 0) {
                mostrarMensaje("Agregue al menos un producto a la venta.");
                return;
            }
            var idEmpleado = parseInt($("#idEmpleado").val(), 10);
            if (!idEmpleado) {
                mostrarMensaje("Seleccione un empleado.");
                return;
            }
            var payload = {
                IdEmpleado: idEmpleado,
                IdCliente: $("#idCliente").val() ? parseInt($("#idCliente").val(), 10) : null,
                Detalle: detalleActual.map(function (d) { return { IdProducto: d.idProducto, Cantidad: d.cantidad }; })
            };
            $.ajax({
                url: "@Url.Action("Registrar", "Ventas")",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ venta: payload })
            }).done(function (resp) {
                if (!resp.success) {
                    mostrarError(resp);
                    return;
                }
                idVentaActiva = resp.idVenta;
                detalleActual = [];
                renderDetalle();
                $("#idVentaActual").text(idVentaActiva);
                $("#cardOperarVenta").show();
                $("#detalleVenta").text("");
                mostrarMensaje(resp.message, "Venta registrada");
            }).fail(function () { mostrarError(); });
        });

        $("#btnProcesarVenta").on("click", function () {
            if (!idVentaActiva) { mostrarMensaje("Registre una venta primero."); return; }
            var request = { IdTipoPago: parseInt($("#idTipoPago").val(), 10) };
            $.ajax({
                url: "@Url.Action("Procesar", "Ventas")",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ idVenta: idVentaActiva, request: request })
            }).done(function (resp) {
                if (!resp.success) {
                    mostrarError(resp);
                    return;
                }
                mostrarMensaje(resp.message, "Venta cobrada");

                // Renderizar factura y mostrar offcanvas
                if (resp.comprobante) {
                    renderizarFactura(resp.comprobante);
                    var offcanvas = new bootstrap.Offcanvas(document.getElementById("offcanvasFactura"));
                    offcanvas.show();
                }
            }).fail(function () { mostrarError(); });
        });

        $("#btnAnularVenta").on("click", function () {
            if (!idVentaActiva) { mostrarMensaje("Registre una venta primero."); return; }
            var request = { MotivoAnulacion: $("#motivoAnulacion").val() };
            $.ajax({
                url: "@Url.Action("Anular", "Ventas")",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ idVenta: idVentaActiva, request: request })
            }).done(function (resp) {
                if (!resp.success) {
                    mostrarError(resp);
                    return;
                }
                mostrarMensaje(resp.message, "Venta anulada");
                $("#cardOperarVenta").hide();
                idVentaActiva = null;
                cargarDatosIniciales();
            }).fail(function () { mostrarError(); });
        });

        // ===== FUNCIONES DE FACTURA =====
        function renderizarFactura(comprobante) {
            // Clonar template de factura
            var template = $("#facturaTemplate").clone();
            template.removeAttr("id").show();

            // Llenar datos de la factura
            template.find("#facturaNumero").text(comprobante.NumeroFactura || "---");

            var fechaObj = new Date(comprobante.FechaFactura);
            var fechaStr = ("0" + fechaObj.getDate()).slice(-2) + "/" + 
                          ("0" + (fechaObj.getMonth() + 1)).slice(-2) + "/" + 
                          fechaObj.getFullYear();
            var horaStr = ("0" + fechaObj.getHours()).slice(-2) + ":" + 
                         ("0" + fechaObj.getMinutes()).slice(-2);
            template.find("#facturaFecha").text(fechaStr);
            template.find("#facturaHora").text(horaStr);

            // Obtener nombre del empleado seleccionado
            var idEmpleadoActual = parseInt($("#idEmpleado").val(), 10);
            var nombreEmpleado = $("#idEmpleado option:selected").text() || ("Empleado ID: " + idEmpleadoActual);
            template.find("#facturaVendedor").text(nombreEmpleado);
            template.find("#facturaMetodoPago").text(comprobante.MetodoPago || "---");

            // Llenar detalles de productos
            var detalleBody = template.find("#facturaDetalleBody").empty();
            var subtotalTotal = 0;
            if (comprobante.Detalle && Array.isArray(comprobante.Detalle)) {
                comprobante.Detalle.forEach(function (item) {
                    var subtotal = item.Cantidad * item.PrecioUnitario;
                    subtotalTotal += subtotal;
                    detalleBody.append(
                        "<tr>" +
                        "<td>" + (item.NombreProducto || "Producto") + "</td>" +
                        "<td class='text-center'>" + item.Cantidad + "</td>" +
                        "<td class='text-right'>₡ " + parseFloat(item.PrecioUnitario || 0).toFixed(2) + "</td>" +
                        "<td class='text-right'>₡ " + parseFloat(subtotal).toFixed(2) + "</td>" +
                        "</tr>"
                    );
                });
            }

            // Calcular IVA (13%)
            var ivaTotal = subtotalTotal * 0.13;
            var totalFinal = subtotalTotal + ivaTotal;

            template.find("#facturaSubtotal").text("₡ " + parseFloat(subtotalTotal).toFixed(2));
            template.find("#facturaIVA").text("₡ " + parseFloat(ivaTotal).toFixed(2));
            template.find("#facturaTotal").text("₡ " + parseFloat(totalFinal).toFixed(2));

            // Insertar factura en el offcanvas
            $("#factura-container").html(template.html());

            // Guardar referencia para descargar
            window.facturaActual = {
                numeroFactura: comprobante.NumeroFactura,
                elemento: template
            };
        }

        // ===== DESCARGAR PDF =====
        $("#btnDescargarPDF").on("click", function () {
            var elemento = document.querySelector(".factura-page");
            if (!elemento) {
                mostrarMensaje("No hay factura para descargar.");
                return;
            }

            var nombreArchivo = "Factura_" + (window.facturaActual?.numeroFactura || "venta") + ".pdf";

            var opciones = {
                margin: 5,
                filename: nombreArchivo,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'letter', orientation: 'portrait' }
            };

            html2pdf().set(opciones).from(elemento).save();
            mostrarMensaje("PDF descargado correctamente.", "Descarga completada");
        });

        renderDetalle();
        cargarDatosIniciales();
    </script>
}
