@{
    ViewBag.Title = "Ventas";
}

<h2 class="fw-bold mb-4">Punto de Venta</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Buscar productos</div>
            <div class="card-body">
                <div class="input-group mb-3">
                    <input type="text" id="txtBuscarProducto" class="form-control" placeholder="Nombre, codigo o categoria" />
                    <button type="button" id="btnBuscarProducto" class="btn btn-outline-secondary">Buscar</button>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tblProductos"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Detalle de la venta (GPV-001)</div>
            <div class="card-body">
                <div class="mb-2">
                    <label>ID Empleado</label>
                    <input type="number" id="idEmpleado" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>ID Cliente (opcional)</label>
                    <input type="number" id="idCliente" class="form-control" />
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tblDetalleVenta"></tbody>
                </table>
                <button type="button" id="btnRegistrarVenta" class="btn btn-primary w-100">Registrar venta</button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Procesar / Anular venta</div>
            <div class="card-body">
                <div class="mb-2">
                    <label>ID Venta</label>
                    <input type="number" id="idVentaOperar" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>ID Tipo de Pago (para procesar)</label>
                    <input type="number" id="idTipoPago" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Motivo de anulacion (opcional)</label>
                    <input type="text" id="motivoAnulacion" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button type="button" id="btnProcesarVenta" class="btn btn-success flex-fill">Procesar pago (GPV-002)</button>
                    <button type="button" id="btnAnularVenta" class="btn btn-danger flex-fill">Anular venta (GPV-003)</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Detalle de venta (GPV-005 / GPV-006)</div>
            <div class="card-body">
                <button type="button" id="btnVerDetalle" class="btn btn-outline-primary mb-3">Ver detalle</button>
                <pre id="detalleVenta" class="bg-light p-2" style="min-height:100px;"></pre>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var detalleActual = [];

        function renderDetalle() {
            var $tbody = $("#tblDetalleVenta");
            $tbody.empty();
            detalleActual.forEach(function (item, idx) {
                $tbody.append(
                    "<tr><td>" + item.nombre + " (Id " + item.idProducto + ")</td>" +
                    "<td>" + item.cantidad + "</td>" +
                    "<td><button type='button' class='btn btn-sm btn-outline-danger' onclick='quitarDetalle(" + idx + ")'>Quitar</button></td></tr>"
                );
            });
        }

        function quitarDetalle(idx) {
            detalleActual.splice(idx, 1);
            renderDetalle();
        }

        $("#btnBuscarProducto").on("click", function () {
            $.get("@Url.Action("BuscarProductos", "Ventas")", { texto: $("#txtBuscarProducto").val() })
                .done(function (resp) {
                    var $tbody = $("#tblProductos");
                    $tbody.empty();
                    if (!resp.success) {
                        alert(resp.message);
                        return;
                    }
                    (resp.data || []).forEach(function (p) {
                        $tbody.append(
                            "<tr><td>" + p.codigo + "</td><td>" + p.nombre + "</td><td>" + p.precio + "</td><td>" + p.stockDisponible + "</td>" +
                            "<td><button type='button' class='btn btn-sm btn-outline-primary' onclick='agregarProducto(" + p.idProducto + ", \"" + p.nombre.replace(/"/g, "") + "\")'>Agregar</button></td></tr>"
                        );
                    });
                })
                .fail(function () { alert("Error en el sistema, por favor intente nuevamente."); });
        });

        function agregarProducto(idProducto, nombre) {
            var cantidad = parseInt(prompt("Cantidad para " + nombre, "1"), 10);
            if (!cantidad || cantidad <= 0) return;
            detalleActual.push({ idProducto: idProducto, nombre: nombre, cantidad: cantidad });
            renderDetalle();
        }

        $("#btnRegistrarVenta").on("click", function () {
            if (detalleActual.length === 0) {
                alert("Agregue al menos un producto a la venta.");
                return;
            }
            var payload = {
                IdEmpleado: parseInt($("#idEmpleado").val(), 10),
                IdCliente: $("#idCliente").val() ? parseInt($("#idCliente").val(), 10) : null,
                Detalle: detalleActual.map(function (d) { return { IdProducto: d.idProducto, Cantidad: d.cantidad }; })
            };
            $.ajax({
                url: "@Url.Action("Registrar", "Ventas")",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ venta: payload })
            }).done(function (resp) {
                alert(resp.message);
                if (resp.success) {
                    detalleActual = [];
                    renderDetalle();
                    $("#idVentaOperar").val(resp.idVenta);
                }
            }).fail(function () { alert("Error en el sistema, por favor intente nuevamente."); });
        });

        $("#btnProcesarVenta").on("click", function () {
            var idVenta = parseInt($("#idVentaOperar").val(), 10);
            var request = { IdTipoPago: parseInt($("#idTipoPago").val(), 10) };
            $.ajax({
                url: "@Url.Action("Procesar", "Ventas")",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ idVenta: idVenta, request: request })
            }).done(function (resp) { alert(resp.message); })
              .fail(function () { alert("Error en el sistema, por favor intente nuevamente."); });
        });

        $("#btnAnularVenta").on("click", function () {
            var idVenta = parseInt($("#idVentaOperar").val(), 10);
            var request = { MotivoAnulacion: $("#motivoAnulacion").val() };
            $.ajax({
                url: "@Url.Action("Anular", "Ventas")",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ idVenta: idVenta, request: request })
            }).done(function (resp) { alert(resp.message); })
              .fail(function () { alert("Error en el sistema, por favor intente nuevamente."); });
        });

        $("#btnVerDetalle").on("click", function () {
            var idVenta = parseInt($("#idVentaOperar").val(), 10);
            $.get("@Url.Action("ObtenerDetalle", "Ventas")", { idVenta: idVenta })
                .done(function (resp) {
                    if (!resp.success) {
                        $("#detalleVenta").text(resp.message);
                        return;
                    }
                    $("#detalleVenta").text(JSON.stringify(resp.data, null, 2));
                })
                .fail(function () { alert("Error en el sistema, por favor intente nuevamente."); });
        });
    </script>
}
