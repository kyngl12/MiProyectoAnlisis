@model List<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Promocion.PromocionDto>

@{
    ViewBag.Title = "Promociones";
}

<div class="container py-5">
    <div class="card-modern p-3">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Promociones</h2>

            @Html.ActionLink(
                "Nueva Promocion",
                "AgregarPromocion",
                "Promocion",
                null,
                new { @class = "btn btn-primary" }
            )
        </div>

        <form method="post"
              action="@Url.Action("Buscar", "Promocion")"
              class="mb-4">

            @Html.AntiForgeryToken()

            <div class="row g-2 align-items-end">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Promoción o producto
                    </label>

                    <input type="text"
                           name="criterio"
                           value="@ViewBag.Criterio"
                           class="form-control"
                           placeholder="Buscar por nombre de promoción o producto" />

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Estado
                    </label>

                    <select name="idEstado"
                            class="form-select">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="1"
                                @(Convert.ToString(ViewBag.IdEstado) == "1" ? "selected" : "")>
                            Activa
                        </option>

                        <option value="2"
                                @(Convert.ToString(ViewBag.IdEstado) == "2" ? "selected" : "")>
                            Inactiva
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <button class="btn btn-primary w-100"
                            type="submit">
                        Consultar
                    </button>

                </div>

            </div>

        </form>

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["MensajeError"]
            </div>
        }

        @if (TempData["MensajeInfo"] != null)
        {
            <div class="alert alert-info">
                @TempData["MensajeInfo"]
            </div>
        }

    <table class="table table-hover table-bordered">

        <thead style="background-color:#1f6f8b; color:white;">
            <tr>
                <th>ID</th>
                <th>Promocion</th>
                <th>Descripcion</th>
                <th>Descuento</th>
                <th>Vigencia</th>
                <th>Producto</th>
                <th>Estado</th>
                <th style="width:220px;">Acciones</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>

                        <td>@item.IdPromocion</td>

                        <td>@item.NombrePromocion</td>

                        <td>
                            @(item.Descripcion != null && item.Descripcion.Length > 40
                            ? item.Descripcion.Substring(0, 40) + "..."
                            : item.Descripcion)
                        </td>

                        <td>@item.PorcentajeDescuento %</td>

                        <td>
                            @item.FechaInicio.ToString("dd/MM/yyyy")
                            <br />
                            <small>al @item.FechaFin.ToString("dd/MM/yyyy")</small>
                        </td>

                        <td>@item.IdProducto</td>

                        <td>
                            @(item.IdEstado == 1 ? "Activa" : "Inactiva")
                        </td>

                        <td>

                            <div class="d-flex gap-2 align-items-center">

                                @Html.ActionLink(
                                    "Editar",
                                    "EditarPromocion",
                                    "Promocion",
                                    new { id = item.IdPromocion },
                                    new { @class = "btn btn-sm btn-outline-warning" }
                                )

                                @using (Html.BeginForm("DesactivarPromocion", "Promocion", FormMethod.Post, new { @class = "m-0 p-0" }))
                                {
                                    @Html.AntiForgeryToken()

                                    @Html.Hidden("id", item.IdPromocion)

                                    if (item.IdEstado == 1)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Desactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                            Inactiva
                                        </button>
                                    }
                                }

                            </div>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        No hay promociones registradas.
                    </td>
                </tr>
            }

        </tbody>

    </table>

    </div>
</div>