<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Gestion PubRock</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap (local fallback) -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!-- Project styles (keep existing structure + custom overrides) -->
    <link href="~/Content/Styles/variables.css" rel="stylesheet" />
    <link href="~/Content/Styles/layout.css" rel="stylesheet" />
    <link href="~/Content/Styles/components.css" rel="stylesheet" />
    <link href="~/Content/Styles/forms.css" rel="stylesheet" />
    <link href="~/Content/Styles/tables.css" rel="stylesheet" />
    <link href="~/Content/Styles/buttons.css" rel="stylesheet" />
    <link href="~/Content/Styles/dashboard.css" rel="stylesheet" />
    <link href="~/Content/Styles/animations.css" rel="stylesheet" />
    <link href="~/Content/site.custom.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.css" rel="stylesheet" />
</head>
<body>

    <div class="app-shell d-flex">
        <aside class="app-sidebar bg-white border-end">
            <div class="logo mb-4"><span class="brand">PubRock</span></div>

            @if (User.Identity.IsAuthenticated)
            {
                if (User.IsInRole("Administrador"))
                {
                    <div class="nav-section-title">Navegación</div>
                    <div class="sidebar-icons">
                        <a href="@Url.Action("Index","Home")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 11.5L12 4l9 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M5 12v7a1 1 0 0 0 1 1h3v-5h6v5h3a1 1 0 0 0 1-1v-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span class="nav-text">Inicio</span>
                        </a>

                        <div class="nav-section-title">Gestion</div>

                        <a href="@Url.Action("ObtenerTodosLosUsuarios","Usuarios")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span class="nav-text">Usuarios</span>
                        </a>

                        <a href="@Url.Action("Index","Inventario")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5" />
                                    <path d="M7 3v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="nav-text">Inventario</span>
                        </a>

                        <a href="@Url.Action("Index","OrdenesListado")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21 15V6a2 2 0 0 0-2-2h-5l-2-2H5a2 2 0 0 0-2 2v11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M7 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span class="nav-text">Ordenes</span>
                        </a>

                        <a href="@Url.Action("Index","Marketing")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M20 8v6a2 2 0 0 1-2 2H8l-4 2V6a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M7 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="nav-text">Marketing</span>
                        </a>

                        <a href="@Url.Action("Index","Reservaciones")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" />
                                    <path d="M16 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                            </span>
                            <span class="nav-text">Reservaciones</span>
                        </a>

                        <a href="@Url.Action("ObtenerTodasLasPromociones","Promocion")" class="nav-link">
                            <span class="nav-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M19 5L5 19" stroke="currentColor"
                                          stroke-width="1.5"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                    <circle cx="7" cy="7" r="2"
                                            stroke="currentColor"
                                            stroke-width="1.5" />
                                    <circle cx="17" cy="17" r="2"
                                            stroke="currentColor"
                                            stroke-width="1.5" />
                                </svg>
                            </span>
                            <span class="nav-text">Promociones</span>
                        </a>

                    </div>
                }
                else if (User.IsInRole("Empleado"))
                {
                    <div class="nav-section-title">Navegación</div>
                    <div class="sidebar-icons">
                        @Html.ActionLink("Inicio","Index","Home",null,new { @class = "nav-link" })
                        @Html.ActionLink("Reservaciones","Index","Reservaciones",null,new { @class = "nav-link" })
                    </div>
                }
            }
            else
            {
                @Html.ActionLink("Inicio","Index","Home",null,new { @class = "nav-link" })
            }

            <div style="margin-top:20px">@Html.Partial("_LoginPartial")</div>
        </aside>

        <main class="app-content flex-grow-1 p-4">
            <nav class="navbar navbar-expand-lg navbar-white bg-white shadow-sm mb-4 rounded">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index","Home")">
                        <span class="brand me-2">PubRock</span>
                        <small class="text-muted">Panel</small>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topbarNav" aria-controls="topbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="topbarNav">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li class="nav-item me-3">
                                    <span class="text-secondary">@User.Identity.Name</span>
                                </li>
                                <li class="nav-item">
                                    @Html.ActionLink("Cerrar sesión","Logout","Account",null,new { @class = "btn btn-outline-secondary btn-sm" })
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    @Html.ActionLink("Iniciar sesión","Login","Account",null,new { @class = "btn btn-primary btn-sm text-white" })
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid">
                @RenderBody()
                <div class="app-footer mt-4 text-center text-muted">© @DateTime.Now.Year - Sistema Gestion PubRock</div>
            </div>
        </main>
    </div>

    <!-- FOOTER -->
    <footer>
        © @DateTime.Now.Year - Sistema Gestion de PubRock
    </footer>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/SweetAlert/sweetalert2@11.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>