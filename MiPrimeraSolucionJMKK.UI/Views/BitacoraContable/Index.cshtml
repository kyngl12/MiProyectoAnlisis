@model List<MiPrimeraSolucionJMKK.Abstacciones.Modelos.Bitacora.BitacoraContableDto>

@{
    ViewBag.Title = "Bitácora Contable";
}

<div class="container py-5">
    <div class="card-modern p-3">

        <h2 class="mb-4"><i class="bi bi-journal-text me-2"></i>Bitácora Contable</h2>

        @if (TempData["MensajeInfo"] != null)
        {
            <div class="alert alert-info">@TempData["MensajeInfo"]</div>
        }

        @using (Html.BeginForm("Index", "BitacoraContable", FormMethod.Get, new { @class = "row g-2 mb-3" }))
        {
            <div class="col-md-3">
                <input type="text" name="cedula" value="@ViewBag.Cedula" class="form-control form-control-sm" placeholder="Cédula del usuario" />
            </div>
            <div class="col-md-3">
                <input type="date" name="fechaInicio" value="@(ViewBag.FechaInicio != null ? ((DateTime)ViewBag.FechaInicio).ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <input type="date" name="fechaFin" value="@(ViewBag.FechaFin != null ? ((DateTime)ViewBag.FechaFin).ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Consultar</button>
                @Html.ActionLink("Descargar PDF", "DescargarPdf", "BitacoraContable",
                    new { cedula = ViewBag.Cedula, fechaInicio = ViewBag.FechaInicio, fechaFin = ViewBag.FechaFin },
                    new { @class = "btn btn-outline-primary btn-sm" })
            </div>
        }

        <table class="table table-hover table-bordered">
            <thead style="background-color:#1f6f8b; color:white;">
                <tr>
                    <th>Fecha y Hora</th>
                    <th>Usuario</th>
                    <th>Módulo</th>
                    <th>Acción</th>
                    <th>Descripción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.NombreUsuario ?? item.Cedula)</td>
                            <td>@item.Modulo</td>
                            <td>@item.AccionRealizada</td>
                            <td>@item.Descripcion</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No se encontraron movimientos contables para los filtros seleccionados.</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
