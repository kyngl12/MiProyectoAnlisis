@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Reportes.ReporteVentasDto

@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "Reporte de Ventas";
    var cultura = new CultureInfo("es-CR");
}

<div class="container py-5">

    <div class="card-modern p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Reporte de Ventas</h2>

                <p class="text-muted mb-0">
                    Consulte las ventas realizadas en un período determinado.
                </p>
            </div>

            <script>
                // Actualizar inputs de exportación antes de enviar
                (function(){
                    var formX = document.getElementById('formExportExcel');
                    var formP = document.getElementById('formExportPdf');
                    var fInicio = document.getElementById('fechaInicio');
                    var fFin = document.getElementById('fechaFin');
                    if (formX && formP && fInicio && fFin) {
                        formX.addEventListener('submit', function(){ document.getElementById('expFechaInicio').value = fInicio.value; document.getElementById('expFechaFin').value = fFin.value; });
                        formP.addEventListener('submit', function(){ document.getElementById('expPdfFechaInicio').value = fInicio.value; document.getElementById('expPdfFechaFin').value = fFin.value; });
                    }
                })();
            </script>
        </div>

        @using (Html.BeginForm(
            "ReporteVentas",
            "Reporte",
            FormMethod.Post,
            new { @class = "mb-4" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label for="fechaInicio"
                           class="form-label fw-semibold">
                        Fecha de inicio
                    </label>

                    <input type="date"
                           id="fechaInicio"
                           name="fechaInicio"
                           class="form-control"
                           value="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="col-md-4">
                    <label for="fechaFin"
                           class="form-label fw-semibold">
                        Fecha de finalización
                    </label>

                    <input type="date"
                           id="fechaFin"
                           name="fechaFin"
                           class="form-control"
                           value="@Model.FechaFin.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="col-md-4">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Generar Reporte
                    </button>
                </div>

            </div>
        }

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensajeExito"]
            </div>
        }

        @if (ViewBag.MensajeInfo != null)
        {
            <div class="alert alert-info">
                @ViewBag.MensajeInfo
            </div>
        }

        @if (ViewBag.MensajeError != null)
        {
            <div class="alert alert-danger">
                @ViewBag.MensajeError
            </div>
        }

        @if (Model.Ventas != null && Model.Ventas.Any())
        {
            <hr class="my-4" />

            <div class="mb-4">
                <h4 class="mb-1">
                    Resultados del reporte
                </h4>

                <p class="text-muted">
                    Período:
                    <strong>
                        @Model.FechaInicio.ToString("dd/MM/yyyy")
                    </strong>
                    al
                    <strong>
                        @Model.FechaFin.ToString("dd/MM/yyyy")
                    </strong>
                </p>
            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">
                            Total de ventas
                        </small>

                        <h3 class="mb-0 mt-2">
                            @Model.Ventas.Count
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">
                            Cantidad de transacciones
                        </small>

                        <h3 class="mb-0 mt-2">
                            @Model.CantidadTransacciones
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <small class="text-muted">
                            Monto final recaudado
                        </small>

                        <h3 class="mb-0 mt-2">
                            @Model.MontoFinalRecaudado.ToString("C", cultura)
                        </h3>
                    </div>
                </div>

            </div>

            <div class="mb-3 d-flex gap-2">
                @* Formas de exportación *@
                @using (Html.BeginForm("ExportarExcel", "Reporte", FormMethod.Post, new { id = "formExportExcel" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fechaInicio" id="expFechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaFin" id="expFechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="idCategoria" id="expIdCategoria" value="" />
                    <input type="hidden" name="idTipoPago" id="expIdTipoPago" value="" />
                    <input type="hidden" name="idCliente" id="expIdCliente" value="" />
                    <input type="hidden" name="idEstado" id="expIdEstado" value="" />
                    <button type="submit" class="btn btn-outline-success">Exportar Excel</button>
                }

                @using (Html.BeginForm("ExportarPdf", "Reporte", FormMethod.Post, new { id = "formExportPdf" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fechaInicio" id="expPdfFechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaFin" id="expPdfFechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="idCategoria" id="expPdfIdCategoria" value="" />
                    <input type="hidden" name="idTipoPago" id="expPdfIdTipoPago" value="" />
                    <input type="hidden" name="idCliente" id="expPdfIdCliente" value="" />
                    <input type="hidden" name="idEstado" id="expPdfIdEstado" value="" />
                    <button type="submit" class="btn btn-outline-danger">Exportar PDF</button>
                }
            </div>

            <h4 class="mb-3">
                Métodos de pago utilizados
            </h4>

            <div class="table-responsive mb-5">

                <table class="table table-hover table-bordered">

                    <thead style="background-color:#1f6f8b; color:white;">
                        <tr>
                            <th>Método de pago</th>
                            <th>Transacciones</th>
                            <th>Monto recaudado</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.MetodosPago != null &&
                             Model.MetodosPago.Any())
                        {
                            foreach (var metodo in Model.MetodosPago)
                            {
                                <tr>
                                    <td>@metodo.MetodoPago</td>

                                    <td>
                                        @metodo.CantidadTransacciones
                                    </td>

                                    <td>
                                        @metodo.MontoTotal.ToString(
                                            "C",
                                            cultura
                                        )
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted">
                                    No hay métodos de pago registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }

    </div>

</div>