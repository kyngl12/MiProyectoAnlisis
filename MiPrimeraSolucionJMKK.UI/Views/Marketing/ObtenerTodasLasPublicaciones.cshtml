@model List<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Marketing.MarketingDto>

@{
    ViewBag.Title = "Publicaciones";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Publicaciones</h2>

        @Html.ActionLink(
            "Nueva Publicación",
            "AgregarPublicacion",
            "Marketing",
            null,
            new { @class = "btn btn-primary" }
        )
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Contenido</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th style="width: 220px;">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdPublicacion</td>
                        <td>@item.Titulo</td>
                        <td>
                            @(item.Contenido != null && item.Contenido.Length > 40
                            ? item.Contenido.Substring(0, 40) + "..."
                            : item.Contenido)
                        </td>
                        <td>@item.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                        <td>
                            @(item.IdEstado == 1 ? "Activa" : "Inactiva")
                        </td>

                        <td>
                            @Html.ActionLink(
                                "Editar",
                                "EditarPublicacion",
                                "Marketing",
                                new { id = item.IdPublicacion },
                                new { @class = "btn btn-sm btn-warning me-1" }
                            )

                            @using (Html.BeginForm("DesactivarPublicacion", "Marketing", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", item.IdPublicacion)

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('¿Desactivar esta publicación?');">
                                    Desactivar
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No hay publicaciones registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>