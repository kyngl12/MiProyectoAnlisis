@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Marketing.MarketingDto

@{
    ViewBag.Title = "Agregar Publicación";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-4">
                        <i class="bi bi-megaphone-fill me-2"></i>Agregar Nueva Publicación
                    </h2>

                    @if (TempData["MensajeError"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("AgregarPublicacion", "Marketing", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Titulo, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Ej: Promo 2x1 en hamburguesas" })
                            @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 4, placeholder = "Descripción de la publicación..." })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.FechaInicio, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.FechaFinalizacion, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.FechaFinalizacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.FechaFinalizacion, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.TipoContenido, new { @class = "form-label" })

                            @Html.DropDownListFor(
                                m => m.TipoContenido,
                                new SelectList(
                                    new[]
                                    {
                                        "Menú",
                                        "Evento",
                                        "Promoción"
                                    }
                                ),
                                "-- Seleccione tipo --",
                                new { @class = "form-select" }
                            )

                            @Html.ValidationMessageFor(m => m.TipoContenido, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Precio, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", placeholder = "Solo si es menú", type = "number", step = "0.01" })
                            @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.IdEstado, new { @class = "form-label" })
                            @Html.DropDownListFor(
                                m => m.IdEstado,
                                new SelectList(
                                    new[]
                                    {
                                        new { Value = 1, Text = "Activo" },
                                        new { Value = 2, Text = "Inactivo" }
                                    },
                                    "Value",
                                    "Text"
                                ),
                                "-- Seleccione estado --",
                                new { @class = "form-select" }
                            )
                            @Html.ValidationMessageFor(m => m.IdEstado, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            @Html.ActionLink("Cancelar", "ObtenerTodasLasPublicaciones", null, new { @class = "btn btn-secondary" })

                            <button type="submit" class="btn btn-pubrock">
                                <i class="bi bi-check-circle-fill me-1"></i>Guardar Publicación
                            </button>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
