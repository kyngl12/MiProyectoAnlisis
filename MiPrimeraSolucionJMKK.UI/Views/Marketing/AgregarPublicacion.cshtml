@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Marketing.MarketingDto

@{
    ViewBag.Title = "Agregar Publicacion";
}

<style>
    :root {
        --marketing-blue-950: #06142f;
        --marketing-blue-900: #0a1f46;
        --marketing-blue-800: #10376b;
        --marketing-blue-700: #185695;
        --marketing-blue-600: #2878bd;
        --marketing-blue-500: #4298d4;
        --marketing-blue-400: #68a5d8;
        --marketing-blue-300: #9acced;
        --marketing-blue-200: #c9e5f6;
        --marketing-blue-100: #e7f3fb;
        --marketing-blue-50: #f5faff;
        --marketing-white: #ffffff;
        --marketing-text: #14263a;
        --marketing-muted: #718397;
        --marketing-border: #dce9f3;
        --marketing-border-light: #eaf1f7;
        --marketing-shadow-sm: 0 7px 22px rgba(6,20,47,.08);
        --marketing-shadow-md: 0 18px 42px rgba(6,20,47,.12);
        --marketing-shadow-lg: 0 28px 65px rgba(6,20,47,.16);
    }

    .marketing-page {
        width: 100%;
        padding: 18px 0 35px;
    }

    .marketing-hero {
        position: relative;
        min-height: 230px;
        padding: 42px 46px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 28px;
        border-radius: 24px;
        background: radial-gradient(circle at 85% 20%, rgba(104,165,216,.25), transparent 30%), radial-gradient(circle at 15% 90%, rgba(40,120,189,.18), transparent 32%), linear-gradient(135deg, var(--marketing-blue-950), var(--marketing-blue-800));
        box-shadow: var(--marketing-shadow-lg);
        overflow: hidden;
    }

        .marketing-hero::before {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -140px;
            top: -160px;
            border: 54px solid rgba(255,255,255,.035);
            border-radius: 50%;
        }

        .marketing-hero::after {
            content: attr(data-word);
            position: absolute;
            right: 30px;
            bottom: -12px;
            color: rgba(255,255,255,.035);
            font-size: clamp(4rem,8vw,8rem);
            font-weight: 800;
            letter-spacing: -.08em;
            line-height: .8;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }

    .marketing-heading,
    .marketing-hero-actions {
        position: relative;
        z-index: 2;
    }

    .marketing-eyebrow {
        display: inline-block;
        margin-bottom: 15px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--marketing-blue-400);
        color: var(--marketing-blue-100);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .marketing-heading h1 {
        margin: 0 0 13px;
        color: var(--marketing-white) !important;
        font-size: clamp(2.3rem,4vw,4.1rem);
        font-weight: 800;
        line-height: 1.03;
        letter-spacing: -.055em;
    }

    .marketing-heading p {
        max-width: 680px;
        margin: 0;
        color: rgba(255,255,255,.74);
        font-size: 1rem;
        line-height: 1.7;
    }

    .marketing-primary-link {
        min-width: 185px;
        min-height: 48px;
        padding: 12px 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.52);
        border-radius: 999px;
        color: var(--marketing-blue-950) !important;
        background: var(--marketing-white);
        font-size: .8rem;
        font-weight: 800;
        text-decoration: none !important;
        box-shadow: 0 12px 28px rgba(0,0,0,.14);
    }

        .marketing-primary-link:hover {
            color: var(--marketing-white) !important;
            background: var(--marketing-blue-500);
            border-color: var(--marketing-blue-500);
            transform: translateY(-2px);
        }

    .marketing-alerts {
        margin-top: 24px;
    }

        .marketing-alerts .alert {
            margin-bottom: 12px;
            padding: 14px 17px;
            border-radius: 12px;
            font-size: .86rem;
            font-weight: 600;
            box-shadow: 0 5px 14px rgba(6,20,47,.05);
        }

        .marketing-alerts .alert-success {
            color: #1f6942;
            background: #effaf4;
            border-color: #bfe7cf;
        }

        .marketing-alerts .alert-danger {
            color: #842029;
            background: #fff2f3;
            border-color: #f3c5ca;
        }

    .marketing-shell {
        margin-top: 25px;
        display: grid;
        grid-template-columns: minmax(0,1.35fr) minmax(260px,.65fr);
        gap: 24px;
    }

    .marketing-panel {
        padding: 32px;
        border: 1px solid var(--marketing-border);
        border-radius: 20px;
        background: linear-gradient(180deg,var(--marketing-white),var(--marketing-blue-50));
        box-shadow: var(--marketing-shadow-md);
    }

    .marketing-panel-header {
        margin-bottom: 28px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--marketing-border-light);
    }

        .marketing-panel-header h2 {
            margin: 0 0 7px;
            color: var(--marketing-blue-950);
            font-size: 1.4rem;
            font-weight: 800;
        }

        .marketing-panel-header p {
            margin: 0;
            color: var(--marketing-muted);
            font-size: .86rem;
            line-height: 1.6;
        }

    .marketing-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .marketing-field {
        margin-bottom: 18px;
    }

        .marketing-field.full-width {
            grid-column: 1 / -1;
        }

        .marketing-field label {
            display: block;
            margin-bottom: 8px;
            color: var(--marketing-text);
            font-size: .82rem;
            font-weight: 700;
        }

        .marketing-field .form-control,
        .marketing-field .form-select {
            min-height: 50px;
            padding: 12px 15px;
            color: var(--marketing-text);
            background: var(--marketing-white);
            border: 1px solid var(--marketing-border);
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(6,20,47,.04);
        }

        .marketing-field textarea.form-control {
            min-height: 125px;
            resize: vertical;
        }

        .marketing-field .form-control:hover,
        .marketing-field .form-select:hover {
            border-color: var(--marketing-blue-300);
        }

        .marketing-field .form-control:focus,
        .marketing-field .form-select:focus {
            border-color: var(--marketing-blue-500);
            box-shadow: 0 0 0 4px rgba(66,152,212,.12);
        }

        .marketing-field .form-control:disabled {
            color: var(--marketing-muted);
            background: #eef4f9;
        }

        .marketing-field .text-danger {
            display: block;
            margin-top: 6px;
            font-size: .78rem;
        }

    .marketing-actions {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
    }

    .marketing-submit,
    .marketing-cancel {
        min-height: 50px;
        padding: 12px 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px !important;
        font-size: .86rem;
        font-weight: 800;
        text-decoration: none !important;
    }

    .marketing-submit {
        border: 1px solid var(--marketing-blue-600) !important;
        color: var(--marketing-white) !important;
        background: linear-gradient(135deg,var(--marketing-blue-600),var(--marketing-blue-700)) !important;
        box-shadow: 0 9px 22px rgba(40,120,189,.22);
    }

        .marketing-submit:hover {
            color: var(--marketing-white) !important;
            background: linear-gradient(135deg,var(--marketing-blue-700),var(--marketing-blue-800)) !important;
            transform: translateY(-2px);
        }

    .marketing-cancel {
        border: 1px solid var(--marketing-blue-200) !important;
        color: var(--marketing-blue-700) !important;
        background: var(--marketing-white) !important;
    }

        .marketing-cancel:hover {
            color: var(--marketing-white) !important;
            background: var(--marketing-blue-700) !important;
            border-color: var(--marketing-blue-700) !important;
            transform: translateY(-2px);
        }

    .marketing-aside {
        padding: 30px;
        border: 1px solid var(--marketing-border);
        border-radius: 20px;
        background: radial-gradient(circle at top right,rgba(104,165,216,.13),transparent 35%), var(--marketing-white);
        box-shadow: var(--marketing-shadow-sm);
    }

    .marketing-aside-number {
        margin-bottom: 20px;
        color: var(--marketing-blue-100);
        font-size: 5.2rem;
        font-weight: 800;
        letter-spacing: -.08em;
        line-height: .85;
    }

    .marketing-aside h3 {
        margin-bottom: 12px;
        color: var(--marketing-blue-950);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .marketing-aside p {
        margin-bottom: 0;
        color: var(--marketing-muted);
        font-size: .88rem;
        line-height: 1.7;
    }

    .marketing-table-section {
        margin-top: 24px;
        border: 1px solid var(--marketing-border);
        border-radius: 20px;
        background: var(--marketing-white);
        box-shadow: var(--marketing-shadow-md);
        overflow: hidden;
    }

    .marketing-table-heading {
        padding: 21px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        border-bottom: 1px solid var(--marketing-border-light);
    }

        .marketing-table-heading h2 {
            margin: 0;
            color: var(--marketing-blue-950);
            font-size: 1.1rem;
            font-weight: 800;
        }

        .marketing-table-heading span {
            color: var(--marketing-muted);
            font-size: .78rem;
        }

    .marketing-table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    .marketing-table {
        width: 100%;
        min-width: 980px;
        margin: 0;
        border-collapse: collapse;
        color: var(--marketing-text);
    }

        .marketing-table thead th {
            padding: 15px 17px;
            color: var(--marketing-blue-800);
            background: var(--marketing-blue-50);
            border-bottom: 1px solid var(--marketing-blue-200);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .075em;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .marketing-table tbody td {
            padding: 16px 17px;
            border-bottom: 1px solid var(--marketing-border-light);
            font-size: .84rem;
            vertical-align: middle;
        }

        .marketing-table tbody tr:hover {
            background: #f9fcff;
        }

    .marketing-id {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border: 1px solid var(--marketing-blue-100);
        border-radius: 999px;
        color: var(--marketing-blue-700);
        background: var(--marketing-blue-50);
        font-size: .74rem;
        font-weight: 800;
    }

    .marketing-title {
        color: var(--marketing-blue-950);
        font-weight: 800;
    }

    .marketing-content {
        max-width: 320px;
        color: var(--marketing-muted);
        line-height: 1.5;
    }

    .marketing-date {
        color: var(--marketing-blue-900);
        font-weight: 700;
        white-space: nowrap;
    }

    .marketing-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: .73rem;
        font-weight: 800;
    }

        .marketing-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .marketing-status.active {
            color: #1f6942;
            background: #effaf4;
            border: 1px solid #bfe7cf;
        }

        .marketing-status.inactive {
            color: #842029;
            background: #fff2f3;
            border: 1px solid #f3c5ca;
        }

    .marketing-row-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .marketing-row-actions .btn {
            min-height: 34px;
            padding: 7px 11px;
            border-radius: 8px !important;
            font-size: .72rem;
            font-weight: 800;
        }

    .marketing-edit-button {
        color: #966500 !important;
        background: #fff9e8 !important;
        border-color: #edd68d !important;
    }

    .marketing-disable-button {
        color: #9a2531 !important;
        background: #fff1f2 !important;
        border-color: #efbdc2 !important;
    }

    .marketing-enable-button {
        color: #1f6942 !important;
        background: #effaf4 !important;
        border-color: #bfe7cf !important;
    }

    .marketing-empty {
        padding: 55px 20px !important;
        color: var(--marketing-muted);
        text-align: center;
    }

    @@media (max-width: 991.98px) {
        .marketing-hero {
            min-height: 290px;
            padding: 36px 32px;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-end;
        }

        .marketing-hero-actions,
        .marketing-primary-link {
            width: 100%;
        }

        .marketing-shell {
            grid-template-columns: 1fr;
        }

        .marketing-aside {
            order: -1;
        }
    }

    @@media (max-width: 767.98px) {
        .marketing-grid {
            grid-template-columns: 1fr;
        }

        .marketing-field.full-width {
            grid-column: auto;
        }
    }

    @@media (max-width: 575.98px) {
        .marketing-hero {
            min-height: 320px;
            padding: 30px 22px;
            border-radius: 18px;
        }

        .marketing-heading h1 {
            font-size: 2.4rem;
        }

        .marketing-panel,
        .marketing-aside {
            padding: 24px 20px;
            border-radius: 16px;
        }

        .marketing-actions {
            flex-direction: column;
        }

        .marketing-submit,
        .marketing-cancel {
            width: 100%;
        }
    }
</style>

<div class="marketing-page">

    <section class="marketing-hero" data-word="PUBLICAR">

        <div class="marketing-heading">
            <span class="marketing-eyebrow">Gestión de marketing</span>

            <h1>Agregar publicación</h1>

            <p>
                Crea contenido para menú, eventos o promociones
                y define su vigencia, precio y estado.
            </p>
        </div>

    </section>

    <div class="marketing-alerts">

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

    </div>

    <div class="marketing-shell">

        <section class="marketing-panel">

            <div class="marketing-panel-header">
                <h2>Información de la publicación</h2>
                <p>Complete los datos necesarios antes de guardar.</p>
            </div>

            @using (Html.BeginForm("AgregarPublicacion", "Marketing", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="marketing-grid">

                    <div class="marketing-field full-width">
                        @Html.LabelFor(m => m.Titulo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Ej: Promo 2x1 en hamburguesas" })
                        @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger small" })
                    </div>

                    <div class="marketing-field full-width">
                        @Html.LabelFor(m => m.Contenido, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Contenido, new { @class = "form-control", rows = 4, placeholder = "Descripcion de la publicacion..." })
                        @Html.ValidationMessageFor(m => m.Contenido, "", new { @class = "text-danger small" })
                    </div>

                    <div class="marketing-field">
                        @Html.LabelFor(m => m.FechaInicio, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger small" })
                    </div>

                    <div class="marketing-field">
                        @Html.LabelFor(m => m.FechaFinalizacion, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FechaFinalizacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.FechaFinalizacion, "", new { @class = "text-danger small" })
                    </div>

                    <div class="marketing-field">
                        @Html.LabelFor(m => m.TipoContenido, new { @class = "form-label" })

                        @Html.DropDownListFor(
                            m => m.TipoContenido,
                            new SelectList(new[]
                            {
                                "Menu",
                                "Evento",
                                "Promocion"
                            }),
                            "-- Seleccione tipo --",
                            new { @class = "form-select" }
                        )

                        @Html.ValidationMessageFor(m => m.TipoContenido, "", new { @class = "text-danger small" })
                    </div>

                    <div class="marketing-field">
                        @Html.LabelFor(m => m.Precio, new { @class = "form-label" })

                        @Html.TextBoxFor(m => m.Precio, new
                        {
                            @class = "form-control",
                            type = "number",
                            step = "0.01",
                            placeholder = "Solo si es menu"
                        })

                        @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger small" })
                    </div>

                    <div class="marketing-field full-width">
                        @Html.LabelFor(m => m.IdEstado, new { @class = "form-label" })

                        @Html.DropDownListFor(
                            m => m.IdEstado,
                            new SelectList(new[]
                            {
                                new { Value = 1, Text = "Activo" },
                                new { Value = 2, Text = "Inactivo" }
                            }, "Value", "Text"),
                            "-- Seleccione estado --",
                            new { @class = "form-select" }
                        )

                        @Html.ValidationMessageFor(m => m.IdEstado, "", new { @class = "text-danger small" })
                    </div>

                </div>

                <div class="marketing-actions">

                    @Html.ActionLink(
                        "Cancelar",
                        "ObtenerTodasLasPublicaciones",
                        null,
                        new { @class = "btn btn-secondary marketing-cancel" })

                    <button type="submit" class="btn btn-pubrock marketing-submit">
                        <i class="bi bi-check-circle-fill me-1"></i>Guardar Publicacion
                    </button>

                </div>
            }

        </section>

        <aside class="marketing-aside">
            <div class="marketing-aside-number">01</div>
            <h3>Contenido bien planificado</h3>
            <p>
                Define claramente el título, tipo, fechas y estado antes de publicar.
            </p>
        </aside>

    </div>

</div>