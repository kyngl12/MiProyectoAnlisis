@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Marketing.PublicacionDto

@{
    ViewBag.Title = "Editar Publicación";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-4">
                        <i class="bi bi-pencil-square me-2"></i>Editar Publicación
                    </h2>

                    @if (TempData["MensajeExito"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["MensajeError"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("EditarPublicacion", "Publicaciones", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @* Campos ocultos *@
                        @Html.HiddenFor(m => m.IdPublicacion)
                        @Html.HiddenFor(m => m.FechaPublicacion)

                        <div class="mb-3">
                            @Html.LabelFor(m => m.IdPublicacion, new { @class = "form-label" })
                            <input type="text" class="form-control" value="@Model.IdPublicacion" disabled />
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Titulo, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Ej: Promo fin de semana" })
                            @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Contenido, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Contenido, new { @class = "form-control", rows = 4, placeholder = "Describe la publicación..." })
                            @Html.ValidationMessageFor(m => m.Contenido, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.IdEstado, new { @class = "form-label" })
                                @Html.DropDownListFor(
                                    m => m.IdEstado,
                                    new SelectList(
                                        new[]
                                        {
                                            new { Value = 1, Text = "Activa" },
                                            new { Value = 2, Text = "Inactiva" }
                                        },
                                        "Value",
                                        "Text"
                                    ),
                                    "-- Seleccione --",
                                    new { @class = "form-select" }
                                )
                                @Html.ValidationMessageFor(m => m.IdEstado, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha de Publicación</label>
                                <input type="text" class="form-control" value="@Model.FechaPublicacion.ToString("dd/MM/yyyy")" disabled />
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            @Html.ActionLink("Cancelar", "ObtenerTodasLasPublicaciones", null, new { @class = "btn btn-secondary" })

                            <button type="submit" class="btn btn-pubrock">
                                <i class="bi bi-save-fill me-1"></i>Actualizar Publicación
                            </button>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
