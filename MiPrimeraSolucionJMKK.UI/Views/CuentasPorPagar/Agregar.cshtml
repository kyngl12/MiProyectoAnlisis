@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Contabilidad.CuentaPorPagarDto

@{
    ViewBag.Title = "Nueva Cuenta por Pagar";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card-modern">
                <div class="card-body p-4">

                    <h2 class="mb-4"><i class="bi bi-receipt me-2"></i>Registrar Cuenta por Pagar</h2>

                    @if (TempData["MensajeError"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["MensajeError"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Agregar", "CuentasPorPagar", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Proveedor, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Proveedor, new { @class = "form-control", placeholder = "Nombre del proveedor" })
                            @Html.ValidationMessageFor(m => m.Proveedor, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Monto, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Monto, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
                            @Html.ValidationMessageFor(m => m.Monto, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3, placeholder = "Detalle de la factura o mercadería" })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(m => m.FechaVencimiento, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.FechaVencimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.FechaVencimiento, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            @Html.ActionLink("Cancelar", "Index", "CuentasPorPagar", null, new { @class = "btn btn-secondary" })
                            <button type="submit" class="btn btn-pubrock">
                                <i class="bi bi-check-circle-fill me-1"></i>Guardar
                            </button>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
