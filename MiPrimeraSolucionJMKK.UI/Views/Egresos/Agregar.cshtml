@model MiPrimeraSolucionJMKK.Abstracciones.Modelos.Contabilidad.EgresoDto
@using System.Collections.Generic

@{
    ViewBag.Title = "Registrar Gasto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card-modern">
                <div class="card-body p-4">

                    <h2 class="mb-4">
                        <i class="bi bi-cash-stack me-2"></i>Registrar Egreso / Gasto Operativo
                    </h2>

                    @if (TempData["MensajeError"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["MensajeError"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Agregar", "Egresos", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Monto, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Monto, new
                            {
                                @class = "form-control",
                                type = "number",
                                step = "0.01",
                                min = "0.01",
                                placeholder = "Ingrese el monto del gasto"
                            })
                            @Html.ValidationMessageFor(m => m.Monto, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Descripcion, new
                            {
                                @class = "form-control",
                                rows = 3,
                                placeholder = "Describa el gasto..."
                            })
                            @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.IdEmpleado, new { @class = "form-label" })
                                @Html.DropDownListFor(
                                    m => m.IdEmpleado,
                                    new SelectList(Model.Empleados ?? new List<MiPrimeraSolucionJMKK.Abstracciones.Modelos.Contabilidad.EmpleadoDto>(), "IdEmpleado", "NombreCompleto"),
                                    "-- Seleccione empleado --",
                                    new { @class = "form-select" }
                                )
                                @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Fecha, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new
                                {
                                    @class = "form-control",
                                    type = "date"
                                })
                                @Html.ValidationMessageFor(m => m.Fecha, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            @Html.ActionLink("Cancelar", "Index", "Egresos", null, new { @class = "btn btn-secondary" })
                            <button type="submit" class="btn btn-pubrock">
                                <i class="bi bi-check-circle-fill me-1"></i>Guardar
                            </button>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
