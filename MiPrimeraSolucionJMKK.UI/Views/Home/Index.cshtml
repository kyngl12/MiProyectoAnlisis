@{
    if (User.IsInRole("Cliente"))
    {
        ViewBag.Title = "Inicio";
    }
    else
    {
        ViewBag.Title = "Gestion Operativa y Administrativa PubRock";
    }
}

<style>
    :root {
        --pub-blue-950: #06142f;
        --pub-blue-900: #0a1f46;
        --pub-blue-800: #10376b;
        --pub-blue-700: #185695;
        --pub-blue-600: #2878bd;
        --pub-blue-500: #4298d4;
        --pub-blue-400: #68a5d8;
        --pub-blue-300: #9acced;
        --pub-blue-200: #c9e5f6;
        --pub-blue-100: #e7f3fb;
        --pub-blue-50: #f5faff;
        --pub-white: #ffffff;
        --pub-text: #14263a;
        --pub-muted: #64778a;
        --pub-border: #dce9f3;
        --pub-shadow-sm: 0 8px 24px rgba(6, 20, 47, .08);
        --pub-shadow-md: 0 18px 45px rgba(6, 20, 47, .14);
        --pub-shadow-lg: 0 30px 70px rgba(6, 20, 47, .20);
    }

    html {
        scroll-behavior: smooth;
    }

    /* =====================================================
       PÁGINA DEL CLIENTE
       ===================================================== */

    .client-home {
        width: 100%;
        margin: 0;
        overflow: hidden;
        background: var(--pub-white);
        color: var(--pub-text);
    }

    /* =====================================================
       PORTADA
       ===================================================== */

    .client-hero {
        position: relative;
        min-height: calc(100vh - 118px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 90px 30px;
        background: linear-gradient( 180deg, rgba(4, 15, 40, .54), rgba(4, 15, 40, .82) ), url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRSwCHrVRERCPL7MnwKz9vX3zp7F2rkgkBDLTp90GQJPfPvlVcppSwWCzc&s=10") center center / cover no-repeat;
        isolation: isolate;
    }

        .client-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: radial-gradient( circle at 18% 82%, rgba(40, 120, 189, .55), transparent 31% ), radial-gradient( circle at 82% 20%, rgba(66, 152, 212, .35), transparent 32% );
        }

        .client-hero::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: 0;
            width: 1px;
            height: 75px;
            background: linear-gradient( transparent, rgba(255, 255, 255, .72) );
        }

    .hero-center {
        width: min(840px, 100%);
        margin: auto;
        text-align: center;
        color: var(--pub-white);
    }

    .hero-eyebrow {
        display: inline-block;
        margin-bottom: 24px;
        padding-bottom: 9px;
        border-bottom: 2px solid var(--pub-blue-400);
        color: var(--pub-blue-100);
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .24em;
        text-transform: uppercase;
    }

    .hero-center h1 {
        margin: 0 0 22px;
        color: var(--pub-white) !important;
        font-size: clamp(3.4rem, 8vw, 7rem);
        font-weight: 700;
        line-height: .94;
        letter-spacing: -.065em;
    }

    body.client-layout .client-home {
        margin-top: calc(var(--header-height) * -1);
    }

    body.client-layout .main-content > .container-fluid {
        padding-top: 20px !important;
    }

    body.client-layout .client-home {
        margin-top: calc((var(--header-height) + 20px) * -1);
    }

    .hero-center p {
        max-width: 660px;
        margin: 0 auto 36px;
        color: rgba(255, 255, 255, .84);
        font-size: clamp(1rem, 2vw, 1.23rem);
        line-height: 1.75;
    }

    .hero-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .hero-button {
        min-width: 174px;
        padding: 14px 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--pub-blue-500);
        border-radius: 999px;
        color: var(--pub-white) !important;
        background: var(--pub-blue-600);
        font-size: .86rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-decoration: none !important;
        transition: transform .2s ease, background-color .2s ease, border-color .2s ease, color .2s ease;
    }

        .hero-button:hover {
            color: var(--pub-white) !important;
            background: var(--pub-blue-700);
            border-color: var(--pub-blue-700);
            transform: translateY(-2px);
        }

    .hero-button-outline {
        background: transparent;
        border-color: rgba(255, 255, 255, .58);
    }

        .hero-button-outline:hover {
            color: var(--pub-blue-900) !important;
            background: var(--pub-white);
            border-color: var(--pub-white);
        }

    /* =====================================================
       ESTRUCTURA GENERAL DE SECCIONES
       ===================================================== */

    .client-section {
        padding: 105px 7%;
    }

    .section-inner {
        width: min(1180px, 100%);
        margin: auto;
    }

    .section-label {
        display: inline-block;
        margin-bottom: 15px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--pub-blue-500);
        color: var(--pub-blue-700);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
    }

    .section-title {
        margin-bottom: 24px;
        color: var(--pub-blue-950) !important;
        font-size: clamp(2.25rem, 4vw, 4.4rem);
        font-weight: 700;
        line-height: 1.04;
        letter-spacing: -.055em;
    }

    .section-copy {
        margin-bottom: 0;
        color: var(--pub-muted);
        font-size: 1.05rem;
        line-height: 1.85;
    }

    .section-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 27px;
        padding-bottom: 7px;
        border-bottom: 2px solid var(--pub-blue-500);
        color: var(--pub-blue-700) !important;
        font-size: .84rem;
        font-weight: 800;
        letter-spacing: .07em;
        text-decoration: none !important;
        text-transform: uppercase;
    }

        .section-link::after {
            content: "→";
            font-size: 1.08rem;
            transition: transform .2s ease;
        }

        .section-link:hover::after {
            transform: translateX(5px);
        }

    /* =====================================================
       NUESTRA ESENCIA
       ===================================================== */

    .essence-section {
        background: var(--pub-white);
    }

    .essence-layout {
        display: grid;
        grid-template-columns: .82fr 1.18fr;
        align-items: center;
        gap: 78px;
    }

    .essence-number {
        color: var(--pub-blue-100);
        font-size: clamp(7rem, 15vw, 13rem);
        font-weight: 800;
        line-height: .8;
        letter-spacing: -.09em;
        user-select: none;
    }

    .essence-text {
        max-width: 690px;
    }

    /* =====================================================
       MENÚ
       ===================================================== */

    .experience-section {
        min-height: 600px;
        display: flex;
        align-items: center;
        background: linear-gradient( 90deg, rgba(6, 20, 47, .97) 0%, rgba(6, 20, 47, .88) 48%, rgba(6, 20, 47, .27) 100% ), url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSspBZtt4rqeb7X0MBsOTDK7Xybylzgj1YejR_c2M4toOgTqC7wl8xdHjI&s=10") center center / cover no-repeat;
    }

    .experience-content {
        max-width: 620px;
    }

    .experience-section .section-label {
        color: var(--pub-blue-300);
    }

    .experience-section .section-title {
        color: var(--pub-white) !important;
    }

    .experience-section .section-copy {
        color: rgba(255, 255, 255, .75);
    }

    .experience-section .section-link {
        color: var(--pub-white) !important;
    }

    /* =====================================================
       EVENTOS
       ===================================================== */

    .events-section {
        background: var(--pub-blue-50);
    }

    .events-layout {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        align-items: stretch;
        gap: 68px;
    }

    .events-image {
        min-height: 510px;
        background: linear-gradient( rgba(8, 31, 70, .08), rgba(8, 31, 70, .28) ), url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQHCy994Ta0M18jdjaD4QNTSqRmgQ5VoJJfwp7r_xiHqsM8XTRracUJqSM&s=10") center center / cover no-repeat;
        box-shadow: var(--pub-shadow-md);
    }

    .events-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* =====================================================
       RESERVACIONES
       ===================================================== */

    .reservation-section {
        position: relative;
        overflow: hidden;
        text-align: center;
        background: radial-gradient( circle at top left, rgba(66, 152, 212, .24), transparent 30% ), radial-gradient( circle at bottom right, rgba(40, 120, 189, .18), transparent 30% ), var(--pub-blue-900);
        color: var(--pub-white);
    }

        .reservation-section::before {
            content: "";
            position: absolute;
            width: 340px;
            height: 340px;
            top: -190px;
            right: -130px;
            border: 60px solid rgba(255, 255, 255, .035);
            border-radius: 50%;
        }

        .reservation-section .section-inner {
            position: relative;
            z-index: 2;
        }

        .reservation-section .section-label {
            color: var(--pub-blue-300);
        }

        .reservation-section .section-title {
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            color: var(--pub-white) !important;
        }

        .reservation-section .section-copy {
            max-width: 680px;
            margin-left: auto;
            margin-right: auto;
            color: rgba(255, 255, 255, .75);
        }

    /* =====================================================
       CONTACTO
       ===================================================== */

    .contact-section {
        padding-bottom: 0;
        background: var(--pub-white);
    }

    .contact-heading {
        max-width: 690px;
        margin-bottom: 62px;
    }

    .contact-data {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--pub-border);
        border-bottom: 1px solid var(--pub-border);
    }

    .contact-item {
        padding: 35px 26px;
    }

        .contact-item + .contact-item {
            border-left: 1px solid var(--pub-border);
        }

        .contact-item small {
            display: block;
            margin-bottom: 8px;
            color: var(--pub-blue-600);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .contact-item strong {
            color: var(--pub-blue-950);
            font-weight: 600;
        }

    /* =====================================================
       REDES SOCIALES
       ===================================================== */

    .social-strip {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .social-link {
        position: relative;
        min-height: 280px;
        padding: 48px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        color: var(--pub-white) !important;
        text-decoration: none !important;
        overflow: hidden;
    }

        .social-link:first-child {
            background: linear-gradient( 135deg, rgba(10, 31, 70, .97), rgba(40, 120, 189, .85) );
        }

        .social-link:last-child {
            background: linear-gradient( 135deg, rgba(16, 55, 107, .97), rgba(66, 152, 212, .84) );
        }

        .social-link::before {
            content: "";
            position: absolute;
            width: 210px;
            height: 210px;
            right: -95px;
            bottom: -100px;
            border: 40px solid rgba(255, 255, 255, .05);
            border-radius: 50%;
        }

        .social-link::after {
            content: "↗";
            position: absolute;
            top: 30px;
            right: 36px;
            font-size: 2rem;
            transition: transform .2s ease;
        }

        .social-link:hover::after {
            transform: translate(5px, -5px);
        }

        .social-link small {
            position: relative;
            z-index: 2;
            color: rgba(255, 255, 255, .68);
            font-size: .75rem;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .social-link h3 {
            position: relative;
            z-index: 2;
            margin: 8px 0;
            color: var(--pub-white) !important;
            font-size: 2rem;
            font-weight: 700;
        }

        .social-link p {
            position: relative;
            z-index: 2;
            max-width: 440px;
            margin: 0;
            color: rgba(255, 255, 255, .74);
            line-height: 1.7;
        }

    /* =====================================================
       MAPA
       ===================================================== */

    .map-section {
        background: var(--pub-white);
    }

        .map-section iframe {
            display: block;
            width: 100%;
            height: 460px;
            border: 0;
            filter: saturate(.78) contrast(1.03);
        }

    .map-caption {
        padding: 17px 25px;
        background: var(--pub-blue-950);
        color: rgba(255, 255, 255, .72);
        font-size: .82rem;
        text-align: center;
    }

    /* =====================================================
       ÁREA ADMINISTRATIVA
       ===================================================== */

    .admin-home {
        padding: 30px 0;
    }

    .admin-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(240px, .5fr);
        align-items: center;
        gap: 45px;
        min-height: 390px;
        padding: 55px;
        border-radius: 24px;
        background: radial-gradient( circle at top right, rgba(66, 152, 212, .26), transparent 34% ), linear-gradient( 135deg, var(--pub-blue-950), var(--pub-blue-800) );
        box-shadow: var(--pub-shadow-lg);
        overflow: hidden;
    }

        .admin-hero::after {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -150px;
            bottom: -180px;
            border: 55px solid rgba(255, 255, 255, .04);
            border-radius: 50%;
        }

    .admin-hero-content {
        position: relative;
        z-index: 2;
    }

    .admin-hero h1 {
        position: relative;
        max-width: 750px;
        margin-bottom: 22px;
        padding-bottom: 18px;
        color: var(--pub-white) !important;
        font-size: clamp(2.2rem, 4vw, 4rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -.055em;
    }

        .admin-hero h1::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 80px;
            height: 4px;
            border-radius: 999px;
            background: var(--pub-blue-400);
        }

    .admin-hero .lead {
        max-width: 720px;
        color: rgba(255, 255, 255, .80);
        line-height: 1.75;
    }

    .admin-hero small {
        color: rgba(255, 255, 255, .68);
    }

    .admin-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 27px;
    }

        .admin-actions .btn {
            border-radius: 999px;
            font-weight: 700;
        }

    .btn-white {
        color: var(--pub-blue-900) !important;
        background: var(--pub-white) !important;
        border-color: var(--pub-white) !important;
    }

        .btn-white:hover {
            background: var(--pub-blue-50) !important;
        }

    .btn-pubrock {
        color: var(--pub-white) !important;
        background: var(--pub-blue-500) !important;
        border-color: var(--pub-blue-500) !important;
    }

        .btn-pubrock:hover {
            background: var(--pub-blue-600) !important;
            border-color: var(--pub-blue-600) !important;
        }

    .admin-stat {
        position: relative;
        z-index: 2;
        padding: 32px;
        border: 1px solid rgba(255, 255, 255, .16);
        border-radius: 20px;
        background: rgba(255, 255, 255, .10);
        backdrop-filter: blur(12px);
        color: var(--pub-white);
        box-shadow: 0 20px 45px rgba(0, 0, 0, .17);
    }

    .admin-stat-label {
        font-size: .82rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        opacity: .75;
    }

    .admin-stat-number {
        margin-top: 8px;
        font-size: 2.4rem;
        font-weight: 800;
    }

    .admin-stat-change {
        margin-top: 8px;
        font-size: .84rem;
        opacity: .78;
    }

    /* =====================================================
       ENLACES DE MÓDULOS ADMINISTRATIVOS
       ===================================================== */

    .admin-modules {
        margin-top: 60px;
        border-top: 1px solid var(--pub-border);
    }

    .admin-module {
        display: grid;
        grid-template-columns: 80px 1fr auto;
        align-items: center;
        gap: 24px;
        padding: 28px 10px;
        border-bottom: 1px solid var(--pub-border);
        color: var(--pub-text);
        text-decoration: none !important;
        transition: padding-left .2s ease, background-color .2s ease;
    }

        .admin-module:hover {
            padding-left: 22px;
            color: var(--pub-text);
            background: var(--pub-blue-50);
        }

    .admin-module-number {
        color: var(--pub-blue-300);
        font-size: 2rem;
        font-weight: 800;
    }

    .admin-module-title {
        margin-bottom: 5px;
        color: var(--pub-blue-950);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .admin-module-desc {
        color: var(--pub-muted);
        font-size: .9rem;
    }

    .admin-module-arrow {
        color: var(--pub-blue-600);
        font-size: 1.5rem;
    }

    /* =====================================================
       MÓDULOS DISPONIBLES
       ===================================================== */

    .available-modules {
        margin-top: 60px;
        padding: 45px;
        border: 1px solid var(--pub-border);
        border-radius: 20px;
        background: var(--pub-white);
        box-shadow: var(--pub-shadow-sm);
    }

        .available-modules h3 {
            position: relative;
            margin-bottom: 32px;
            padding-bottom: 13px;
            color: var(--pub-blue-950);
            font-weight: 800;
        }

            .available-modules h3::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                width: 55px;
                height: 3px;
                border-radius: 999px;
                background: var(--pub-blue-500);
            }

        .available-modules li {
            color: var(--pub-muted);
        }

        .available-modules .text-success {
            color: var(--pub-blue-600) !important;
        }

    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 991.98px) {
        .client-home {
            margin: -16px;
        }

        .essence-layout,
        .events-layout {
            grid-template-columns: 1fr;
            gap: 42px;
        }

        .essence-number {
            font-size: 8rem;
        }

        .events-image {
            min-height: 420px;
            order: 2;
        }

        .contact-data {
            grid-template-columns: 1fr;
        }

        .contact-item + .contact-item {
            border-left: 0;
            border-top: 1px solid var(--pub-border);
        }

        .admin-hero {
            grid-template-columns: 1fr;
            padding: 42px;
        }

        .admin-stat {
            max-width: 430px;
        }
    }

    @@media (max-width: 767.98px) {
        .client-section {
            padding: 78px 25px;
        }

        .client-hero {
            min-height: 720px;
            padding: 70px 22px;
        }

        .social-strip {
            grid-template-columns: 1fr;
        }

        .social-link {
            min-height: 240px;
            padding: 38px 26px;
        }

        .experience-section {
            min-height: 640px;
            background: linear-gradient( rgba(6, 20, 47, .89), rgba(6, 20, 47, .89) ), url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSspBZtt4rqeb7X0MBsOTDK7Xybylzgj1YejR_c2M4toOgTqC7wl8xdHjI&s=10") center center / cover no-repeat;
        }

        .map-section iframe {
            height: 350px;
        }

        .admin-home {
            padding: 10px 0;
        }

        .admin-hero {
            padding: 34px 24px;
            border-radius: 18px;
        }

        .admin-actions {
            flex-direction: column;
        }

            .admin-actions .btn {
                width: 100%;
            }

        .admin-module {
            grid-template-columns: 55px 1fr auto;
            gap: 14px;
        }

        .admin-module-number {
            font-size: 1.45rem;
        }

        .available-modules {
            padding: 28px 22px;
        }
    }

    @@media (max-width: 575.98px) {
        .client-home {
            margin: -11px;
        }

        .hero-center h1 {
            font-size: 3.5rem;
        }

        .hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .hero-button {
            width: 100%;
        }

        .client-section {
            padding: 65px 20px;
        }

        .section-title {
            font-size: 2.35rem;
        }

        .essence-number {
            font-size: 6.3rem;
        }

        .events-image {
            min-height: 330px;
        }

        .social-link {
            min-height: 220px;
        }

        .admin-module {
            grid-template-columns: 1fr auto;
        }

        .admin-module-number {
            display: none;
        }
    }
</style>

@if (User.IsInRole("Cliente"))
{
    <div class="client-home">

        <!-- =========================================
             PORTADA
             ========================================= -->
        <section class="client-hero">

            <div class="hero-center">

                <span class="hero-eyebrow">
                    Música · Gastronomía · Experiencias
                </span>

                <h1>PubRock</h1>

                <p>
                    Un lugar donde la energía del rock se encuentra con el sabor,
                    la buena compañía y noches que no se olvidan.
                </p>

                <div class="hero-actions">

                    @Html.ActionLink(
                        "Explorar menú",
                        "Catalogo",
                        "Inventario",
                        null,
                        new { @class = "hero-button" }
                    )

                    <a href="#nuestra-esencia"
                       class="hero-button hero-button-outline">
                        Conocer más
                    </a>

                </div>

            </div>

        </section>

        <!-- =========================================
             NUESTRA ESENCIA
             ========================================= -->
        <section id="nuestra-esencia"
                 class="client-section essence-section">

            <div class="section-inner essence-layout">

                <div class="essence-number">
                    01
                </div>

                <div class="essence-text">

                    <span class="section-label">
                        Nuestra esencia
                    </span>

                    <h2 class="section-title">
                        Sabor, música y personalidad
                    </h2>

                    <p class="section-copy">
                        En <strong>PubRock</strong> fusionamos la energía del rock
                        and roll con la pasión por la cocina de calidad.
                        Somos el lugar ideal para desconectar, compartir con amigos
